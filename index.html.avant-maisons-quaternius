      pouvoirsPerso[k] = o[k];
      if(!pouvoirs.includes(k)) pouvoirs.push(k);
    }
  }catch(e){}
  // rien n'est offert au départ : tout se débloque en produisant un résultat
}
let debloquer = function(nom){
  if(pouvoirs.includes(nom)) return false;
  pouvoirs.push(nom); sauverPouvoirs(); dessinerPouvoirs(nom);
  return true;
};

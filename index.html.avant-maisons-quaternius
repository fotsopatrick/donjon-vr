/* ═══════════════ 7. COMBAT ═══════════════ */
const avant = new THREE.Vector3();
function frapper(){
  if(joueur.atkCd>0 || etat!=='jeu') return;
  window.Sons?.coup();
  // enchaînement : si on frappe dans la foulée, le coup suivant part plus vite
  joueur.combo = (joueur.comboT > 0) ? Math.min(15, joueur.combo + 1) : 0;   // enchaînement jusqu'à 16 coups
  joueur.comboT = 0.8;
  const troisieme = joueur.combo % 4 === 2;  // l'estoc revient tous les 4 coups
  const tourbillon = joueur.combo % 4 === 3; // le tourbillon tous les 4 coups
  joueur.atkCd = [0.40, 0.30, 0.44, 0.62][joueur.combo % 4];
  majJaugeCombo();
  joueur.secousse = Math.max(joueur.secousse, 0.16);
  camera.getWorldDirection(avant);
  let touche = false;
  if(boss && boss.mort<=0){
    const bx = boss.x - joueur.x, bz = boss.z - joueur.z;
    const bd = Math.hypot(bx, bz);
    if(bd < 3.2 && (bx*avant.x + bz*avant.z)/(bd||1) > 0.3){
      frapperBoss(joueur.epee ? 3 : 1);
      window.Sons?.impact();
      joueur.secousse = 0.3;
      return;                       // un coup ne porte que sur une cible
    }
  }
  for(const e of ennemis){
    if(e.vie<=0) continue;
    const dx = e.x*T - joueur.x, dz = e.y*T - joueur.z;
    const d = Math.hypot(dx,dz);
    if(d > (tourbillon ? 3.1 : 2.4)) continue;
    if(!tourbillon){
      const cos = (dx*avant.x + dz*avant.z) / (d||1);
      if(cos < 0.15) continue;            // viser, mais pas au millimètre
    }
    e.vie -= (joueur.epee ? 3 : 1) + (troisieme ? 2 : 0) + (tourbillon ? 4 : 0);
    if(e.vie <= 0){ e.vie = 0; e.mort = 0.55; }
    touche = true;
    joueur.secousse = tourbillon ? 0.75 : (troisieme ? 0.5 : 0.3);
    if(troisieme || tourbillon){                    // ces deux-là repoussent
      const n = d || 1, force = tourbillon ? 2.2 : 1.4;
      e.x += dx/n * force / T; e.y += dz/n * force / T;
    }
  }
  // le guerrier qu'on défie : un vrai adversaire qui encaisse
  if(guerrier && guerrier.vie>0 && guerrier.etat==='combat'){
    const gx = guerrier.x - joueur.x, gz = guerrier.z - joueur.z, gd = Math.hypot(gx,gz);
    if(gd < 3.0 && (gx*avant.x + gz*avant.z)/(gd||1) > 0.15){
      guerrier.vie -= (joueur.epee?3:2) + (troisieme?2:0) + (tourbillon?3:0);
      touche = true; window.Sons?.impact();
      if(guerrier.vie<=0){ guerrier.vie=0; guerrier.jouer('mort'); guerrier.mortT=1.8; dire('Guerrier vaincu !', 3); }
      else guerrier.jouer('hit');
    }
  }
  // le bois cède aussi : un tonneau cassé lâche parfois une fiole
  for(const d of decors){
    if(!d.cassable || d.casse>0) continue;
    const dx = d.x - joueur.x, dz = d.z - joueur.z;
    const dd = Math.hypot(dx, dz);
    if(dd > 2.2) continue;
    if((dx*avant.x + dz*avant.z)/(dd||1) < 0.15) continue;
    d.casse = 0.45; touche = true;
    joueur.secousse = Math.max(joueur.secousse, 0.22);
    bip(150, 0.14, 'sawtooth', 0.07);
    if(Math.random() < 0.42)
      poserObjet(Math.random() < 0.6 ? 'fiole' : 'eclat', d.x, d.z);
  }

  // le quatrième coup lâche une lame d'air qui court au sol
  if(tourbillon){
    lancerTranche();
    bip(520,0.1,'sine',0.07); bip(260,0.34,'sawtooth',0.09,0.06);
  }
  const note = [300, 360, 240, 440][joueur.combo];
  bip(touche?note:170, touche?0.09:0.05, 'square', touche?0.07:0.03);
  if(touche){ bip(troisieme?90:140, troisieme?0.3:0.22, 'sawtooth', 0.07, 0.05); window.Sons?.impact(); }
}

function blesser(vx, vz){
  if(joueur.inv>0) return;
  joueur.vie--; joueur.inv = 1.9;
  window.Sons?.degat();
  joueur.secousse = 0.55;
  dessinerCoeurs(joueur.vie);
  bip(110,0.26,'sawtooth',0.11);
  montrerCoup(vx, vz);
  if(joueur.vie<=0) perdre();
}

/* Un croissant rouge au bord de l'écran, du côté d'où l'on t'a frappé.
   Sans ça, en vue première personne, on meurt sans savoir pourquoi. */
function montrerCoup(vx, vz){
  elCoup.classList.remove('on');
  const a = (vx !== undefined) ? Math.atan2(-vx, -vz) - joueur.lacet : 0;
  elCoup.style.transform = 'rotate(' + (a*180/Math.PI) + 'deg)';
  void elCoup.offsetWidth;
  elCoup.classList.add('on');
}

/* ═══════════════ 8. SONS — repris de l'esprit du jeu 2D ═══════════════ */
let actx=null;
function assurerAudio(){ if(!actx) try{ actx=new (AudioContext||webkitAudioContext)(); }catch(e){} }
function bip(f,d,forme,vol,quand=0){
  assurerAudio(); if(!actx) return;
  const t=actx.currentTime+quand;
  const o=actx.createOscillator(), g=actx.createGain(), lp=actx.createBiquadFilter();
  lp.type='lowpass'; lp.frequency.value=720;     // coupe les aigus criards du chiptune (« ten ten »)
  o.type=forme; o.frequency.value=f;
  g.gain.setValueAtTime(vol*0.30,t); g.gain.exponentialRampToValueAtTime(0.0001,t+d);  // discret : Sons porte le son
  o.connect(lp); lp.connect(g); g.connect(actx.destination); o.start(t); o.stop(t+d+0.02);
}

/* ═══════════════ 9. ÉTAGES, MORT, DÉPART ═══════════════ */
let etat = 'titre';   // titre | jeu | mort

function nouvelEtage(){
  if(estDehors()){
    const d = genererDehors();
    batirDehors();
    joueur.x = d.x*T + T/2;
    joueur.z = d.y*T + T/2;
    joueur.cle = true;                       // dehors, l'escalier est toujours ouvert
    joueur.lacet = 0;                        // on regarde vers l'escalier (au nord)
    joueur.tangage = 0;
    elCle.classList.remove('ok');
    elEtage.textContent = '—';
    dessinerCoeurs();
    scene.fog = new THREE.FogExp2(0x0e1730, 0.015);   // brume de nuit bleutée
    scene.background = new THREE.Color(0x0a1230);     // ciel de nuit
    jour.intensity = 2.7;                             // pleine lune : ça éclaire bien
    jour.color.setHex(0xaec6f0);                     // clair de lune
    renderer.toneMappingExposure = 1.05;
    return;
  }
  scene.fog = new THREE.FogExp2(0x16233c, 0.022);
  scene.background = new THREE.Color(0x080d18);
  jour.intensity = 2.2;
  renderer.toneMappingExposure = 1.3;
  generer();
  batir();
  const s0 = rooms[0];
  joueur.x = cX(s0)*T + T/2;
  joueur.z = cY(s0)*T + T/2;
  // on regarde vers le large : l'axe le plus long de la salle de depart
  joueur.lacet = s0.w >= s0.h ? -Math.PI/2 : 0;
  joueur.cle = false;
  joueur.lacet = 0; joueur.tangage = 0;
  elCle.classList.remove('ok');
  elEtage.textContent = niveau;
  dessinerCoeurs();
}

/* Rebâtit toute la pierre d'après la grille. Appelé au départ, et à chaque fois
   qu'un sort perce un passage ou dresse un mur. */
function construireMurs(){
  if(murIM){ monde.remove(murIM); murIM.dispose(); }
  const murs=[];
  for(let y=0;y<H;y++) for(let x=0;x<W;x++){
    if(grid[y][x]!==WALL) continue;
    // on ne bâtit que la pierre qui touche un endroit où l'on marche
    let vu=false;
    for(let dy=-1;dy<=1 && !vu;dy++) for(let dx=-1;dx<=1;dx++){
      const nx=x+dx, ny=y+dy;
      if(nx<0||ny<0||nx>=W||ny>=H) continue;
      if(grid[ny][nx]!==WALL){ vu=true; break; }
    }
    if(vu) murs.push({x,y});
  }
  murIM = new THREE.InstancedMesh(geoMur, matMur, murs.length);
  const m4 = new THREE.Matrix4(), col = new THREE.Color();
  murs.forEach((c,i)=>{
    m4.makeTranslation(c.x*T+T/2, HT/2, c.y*T+T/2);
    murIM.setMatrixAt(i, m4);
    const v = 0.78 + Math.random()*0.22;      // chaque bloc a sa teinte
    col.setRGB(v, v*0.985, v*0.94);
    murIM.setColorAt(i, col);
  });
  murIM.instanceMatrix.needsUpdate = true;
  murIM.castShadow = true; murIM.receiveShadow = true;
  monde.add(murIM);
}

const SCP = 1.0;   // échelle des Fantasy Props

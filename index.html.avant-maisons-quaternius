<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>LE PETIT DONJON — 3D</title>
<style>
  :root{ --or:#e8b661; --sang:#c8392f; }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;overflow:hidden;background:#05060a;
    font-family:"Iowan Old Style","Palatino Linotype",Georgia,serif;color:#e8dcc0}
  canvas{display:block}

  /* ---- voile d'ambiance par-dessus la 3D ---- */
  #voile{position:fixed;inset:0;pointer-events:none;z-index:5;
    background:
      radial-gradient(ellipse at 50% 45%, transparent 66%, rgba(6,14,30,.14) 88%, rgba(6,14,30,.38) 100%);
    mix-blend-mode:multiply}

  /* ---- ATH ---- */
  #ath{position:fixed;inset:0;pointer-events:none;z-index:10;
    opacity:0;transition:opacity .6s}
  #ath.on{opacity:1}
  .coin{position:absolute;padding:20px 24px}
  #coeurs{left:0;bottom:0;display:flex;gap:9px;align-items:flex-end}
  .coeur{width:26px;height:24px;position:relative;filter:drop-shadow(0 2px 6px #000)}
  .coeur svg{width:100%;height:100%;display:block}
  .coeur.vide{opacity:.22;filter:none}
  .coeur.perte{animation:bat .45s ease-out}
  @keyframes bat{0%{transform:scale(1.5)}100%{transform:scale(1)}}

  #etage{right:0;bottom:0;text-align:right;letter-spacing:.24em;
    font-size:12px;text-transform:uppercase;color:#8b7f66}
  #etage b{display:block;font-size:30px;letter-spacing:.06em;color:var(--or);
    text-shadow:0 0 22px rgba(232,182,97,.5);font-weight:400;line-height:1.1}

  #cle{left:0;top:0;display:flex;align-items:center;gap:10px;
    font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#6d6350;
    transition:color .4s}
  #cle.ok{color:var(--or);text-shadow:0 0 18px rgba(232,182,97,.55)}
  #cle svg{width:20px;height:20px}

  /* ---- messages ---- */
  #msg{position:absolute;left:50%;bottom:16%;transform:translateX(-50%);
    text-align:center;font-size:19px;letter-spacing:.05em;
    text-shadow:0 2px 20px #000, 0 0 40px rgba(0,0,0,.9);
    opacity:0;transition:opacity .5s;max-width:70%;line-height:1.5}
  #msg.on{opacity:1}

  /* ---- écrans ---- */
  .ecran{position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:26px;text-align:center;
    background:radial-gradient(ellipse at 50% 42%, #14100c 0%, #06060a 62%, #000 100%);
    transition:opacity .7s}
  .ecran.parti{opacity:0;pointer-events:none}
  .pause-tab{opacity:.55}
  .pause-tab.on{opacity:1;outline:2px solid #8fb8e8}
  .entree-tab{opacity:.55}
  .entree-tab.on{opacity:1;outline:2px solid #8fb8e8}
  .ecran h1{font-size:min(11vw,74px);letter-spacing:.16em;font-weight:400;
    color:var(--or);text-shadow:0 0 60px rgba(232,182,97,.35);line-height:1}
  .ecran h1 span{display:block;font-size:.3em;letter-spacing:.55em;color:#7b6f58;
    margin-bottom:.9em;text-shadow:none}
  .ecran p{color:#9d917a;font-size:15px;letter-spacing:.06em;line-height:2}
  .ecran kbd{display:inline-block;min-width:26px;padding:3px 8px;margin:0 2px;
    border:1px solid #3d3428;border-radius:5px;background:#15130f;color:var(--or);
    font-family:inherit;font-size:13px}
  .bouton{margin-top:12px;padding:15px 46px;border:1px solid #5c4a2a;
    background:linear-gradient(180deg,#1d1811,#100d09);color:var(--or);
    font-family:inherit;font-size:16px;letter-spacing:.3em;text-transform:uppercase;
    cursor:pointer;transition:.35s;border-radius:2px}
  .bouton:hover{background:linear-gradient(180deg,#2b2317,#171208);
    box-shadow:0 0 40px rgba(232,182,97,.22);letter-spacing:.42em}
  #mort h1{color:var(--sang);text-shadow:0 0 70px rgba(200,57,47,.45)}

  /* ---- viseur ---- */
  #viseur{position:fixed;left:50%;top:50%;width:3px;height:3px;margin:-1.5px;
    border-radius:50%;background:rgba(232,220,192,.5);z-index:9;pointer-events:none;
    opacity:0;transition:opacity .4s}
  #viseur.on{opacity:1}

  /* ---- l'esprit du donjon ---- */
  #esprit{position:fixed;left:50%;top:8%;transform:translateX(-50%);z-index:12;
    width:min(680px,86vw);pointer-events:none;text-align:center;
    opacity:0;transition:opacity .45s}
  #esprit.on{opacity:1}
  #entendu{font-size:26px;letter-spacing:.03em;color:#cfe6ff;min-height:34px;
    text-shadow:0 0 26px rgba(90,160,255,.55), 0 2px 16px #000}
  #entendu.provisoire{opacity:.45;font-style:italic}
  #repond{margin-top:14px;font-size:18px;line-height:1.6;color:#e8dcc0;
    text-shadow:0 2px 18px #000, 0 0 44px rgba(0,0,0,.9)}

  #ecoute{position:fixed;left:50%;bottom:11%;transform:translateX(-50%);z-index:12;
    display:flex;align-items:center;gap:12px;
    padding:9px 20px;border:1px solid rgba(120,180,255,.35);border-radius:40px;
    background:rgba(8,14,26,.62);color:#9fc4ee;font-size:12px;letter-spacing:.24em;
    text-transform:uppercase;opacity:0;transition:opacity .3s;pointer-events:none}
  #ecoute.on{opacity:1}
  #ecoute .pastille{width:9px;height:9px;border-radius:50%;background:#5aa0ff;
    box-shadow:0 0 14px #5aa0ff;animation:pulse 1.1s ease-in-out infinite}
  @keyframes pulse{0%,100%{transform:scale(.75);opacity:.55}50%{transform:scale(1.35);opacity:1}}

  #saisie{position:fixed;left:50%;bottom:22%;transform:translateX(-50%);z-index:14;
    width:min(560px,84vw);display:none}
  #saisie.on{display:block}
  #saisie input{width:100%;padding:14px 20px;border:1px solid #3d5a7a;border-radius:3px;
    background:rgba(6,10,18,.92);color:#dceaff;font-family:inherit;font-size:17px;
    letter-spacing:.03em;outline:none}
  #saisie input:focus{border-color:#5aa0ff;box-shadow:0 0 30px rgba(90,160,255,.28)}

  #pouvoirs{position:fixed;left:50%;bottom:2.5%;transform:translateX(-50%);z-index:11;
    display:flex;gap:9px;flex-wrap:wrap;justify-content:center;max-width:88vw;
    opacity:0;transition:opacity .5s}
  #pouvoirs.on{opacity:1}
  .pouvoir{padding:7px 15px;border:1px solid #4a3f2a;border-radius:2px;
    background:rgba(16,13,9,.82);color:#d8be86;font-family:inherit;font-size:11px;
    letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:.25s}
  .pouvoir:hover{border-color:#e8b661;color:#f4d79a;box-shadow:0 0 22px rgba(232,182,97,.25)}
  .pouvoir.neuf{animation:neuf 1.4s ease-out}
  @keyframes neuf{0%{box-shadow:0 0 60px rgba(232,182,97,.9);transform:scale(1.25)}
                  100%{box-shadow:0 0 0 rgba(232,182,97,0);transform:scale(1)}}

  #coup{position:fixed;inset:0;z-index:8;pointer-events:none;opacity:0}
  #coup::before{content:'';position:absolute;left:50%;top:50%;
    width:150vmax;height:150vmax;margin:-75vmax;border-radius:50%;
    background:conic-gradient(from -35deg,
      rgba(210,40,30,.62) 0deg, rgba(210,40,30,.18) 34deg,
      transparent 70deg, transparent 290deg,
      rgba(210,40,30,.18) 326deg, rgba(210,40,30,.62) 360deg);
    mask:radial-gradient(circle, transparent 38%, #000 62%);
    -webkit-mask:radial-gradient(circle, transparent 38%, #000 62%)}
  #coup.on{animation:coup 1.1s ease-out}
  @keyframes coup{0%{opacity:1}70%{opacity:.5}100%{opacity:0}}

  /* l'enchaînement en cours */
  #combo{position:fixed;left:50%;bottom:23%;transform:translateX(-50%);z-index:9;
    display:flex;gap:7px;opacity:0;transition:opacity .25s;pointer-events:none}
  #combo.on{opacity:1}
  #combo i{width:26px;height:4px;border-radius:2px;background:rgba(220,235,255,.18);
    transition:.18s}
  #combo i.plein{background:#9fd4ff;box-shadow:0 0 14px #6ab6ff;height:6px;margin-top:-1px}
  #combo i.final{background:#ffd77a;box-shadow:0 0 20px #ffb43c}

  /* le radar façon Metal Gear, en haut à gauche */
  #radar{position:fixed;left:14px;top:14px;z-index:20;width:164px;height:164px;
    border-radius:8px;border:1px solid rgba(90,168,255,.4);
    background:rgba(6,12,22,.7);box-shadow:0 0 22px rgba(0,0,0,.5);
    opacity:0;transition:opacity .5s;pointer-events:none}
  #radar.on{opacity:.92}

  #perf{position:fixed;right:8px;top:8px;z-index:30;font-size:11px;
    color:#4a4438;letter-spacing:.1em;font-family:monospace}
</style>
</head>
<body>

<div id="voile"></div>
<div id="coup"></div>
<div id="viseur"></div>

<div id="ath">
  <div class="coin" id="cle">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="8" cy="8" r="4.2"/><path d="M11 11 L20 20 M17 17 l2.5 -2.5 M14.5 14.5 l2 -2"/>
    </svg><span>clé</span>
  </div>
  <div class="coin" id="coeurs"></div>
  <div class="coin" id="etage"><b>1</b>étage</div>
  <div id="msg"></div>
</div>

<div id="esprit"><div id="entendu"></div><div id="repond"></div></div>
<div id="ecoute"><span class="pastille"></span><span>le donjon écoute</span></div>
<div id="saisie"><input id="saisie-txt" placeholder="parle à l'esprit du donjon…" autocomplete="off"></div>
<div id="pouvoirs"></div>
<div id="combo"><i></i><i></i><i></i><i></i></div>

<div class="ecran" id="titre">
  <h1><span>le petit</span>DONJON</h1>
  <p><kbd>Z</kbd><kbd>Q</kbd><kbd>S</kbd><kbd>D</kbd> marcher &nbsp;·&nbsp; souris regarder &nbsp;·&nbsp; <kbd>Maj</kbd> courir<br>
     clic gauche frapper &nbsp;·&nbsp; trouve la clé, ouvre la porte<br>
     <kbd>Espace</kbd> sauter &nbsp;·&nbsp; clic droit foncer &nbsp;·&nbsp; <kbd>E</kbd> statut &nbsp;·&nbsp; <kbd>F</kbd> se voir &nbsp;·&nbsp; <kbd>←</kbd><kbd>→</kbd> tourner &nbsp;·&nbsp; radar en haut à gauche<br>
     <b style="color:#8fb8e8">maintiens <kbd>V</kbd> et prononce ton incantation</b> &nbsp;·&nbsp; <kbd>C</kbd> pour l'écrire<br>
     <span style="color:#7f9ab8">manette Xbox reconnue : sticks, A frapper, B foncer, X parler, Y statut</span></p>
  <div id="choix-joueur" style="margin-bottom:16px;font-size:15px">
    <span style="color:#8fb8e8">Joueur :</span>
    <button class="bouton" data-j="Patrick" style="padding:6px 18px;margin:0 4px;font-size:15px">Patrick</button>
    <button class="bouton" data-j="Hamda" style="padding:6px 18px;margin:0 4px;font-size:15px">Hamda</button>
  </div>
  <div id="choix-entree" style="margin-bottom:14px;font-size:15px">
    <span style="color:#8fb8e8">Entrer par :</span>
    <button class="bouton entree-tab on" data-niv="0" style="padding:6px 18px;margin:0 4px;font-size:15px">Village</button>
    <button class="bouton entree-tab" data-niv="1" style="padding:6px 18px;margin:0 4px;font-size:15px">Donjon</button>
  </div>
  <button class="bouton" id="jouer">Entrer</button>
</div>

<div class="ecran parti" id="mort">
  <h1>MORT</h1>
  <p id="mort-txt"></p>
  <button class="bouton" id="rejouer">Recommencer</button>
</div>

<div class="ecran parti" id="menu-pause">
  <h1 style="font-size:min(9vw,54px)">PAUSE</h1>
  <div id="pause-onglets" style="display:flex;gap:12px">
    <button class="bouton pause-tab on" data-tab="reprendre" style="padding:9px 20px;font-size:16px">Reprendre</button>
    <button class="bouton pause-tab" data-tab="skills" style="padding:9px 20px;font-size:16px">Créer un skill</button>
  </div>

  <div id="tab-reprendre" class="pause-panneau">
    <p style="color:#9fb2cc;max-width:460px">Appuie sur <kbd>Échap</kbd> ou clique Reprendre pour retourner au donjon.</p>
    <button class="bouton" id="btn-reprendre">Reprendre</button>
  </div>

  <div id="tab-skills" class="pause-panneau" style="display:none">
    <div style="width:min(520px,90vw);text-align:left;color:#cfe0f2">
      <div style="display:grid;grid-template-columns:1fr;gap:9px">
        <input id="sk-nom" placeholder="Nom du skill (ex. Éruption)" style="padding:9px;border-radius:8px;border:1px solid #2a3546;background:#0e1420;color:#eaf0f8;font:inherit">
        <select id="sk-elem" style="padding:9px;border-radius:8px;border:1px solid #2a3546;background:#0e1420;color:#eaf0f8;font:inherit">
          <option value="feu">Feu 🔥</option>
          <option value="eau">Eau 💧</option>
          <option value="vent">Vent 🌀</option>
          <option value="autre">Autre / à définir</option>
        </select>
        <input id="sk-inc" placeholder="Incantation (le mot qui le lance, ex. eruption)" style="padding:9px;border-radius:8px;border:1px solid #2a3546;background:#0e1420;color:#eaf0f8;font:inherit">
        <textarea id="sk-effet" rows="2" placeholder="Effet voulu (on le rendra réel ensuite)" style="padding:9px;border-radius:8px;border:1px solid #2a3546;background:#0e1420;color:#eaf0f8;font:inherit;resize:vertical"></textarea>
        <button class="bouton" id="sk-creer" style="padding:9px">Créer le skill</button>
      </div>
      <div style="margin-top:14px;color:#8fb8e8;font-size:13px;text-transform:uppercase;letter-spacing:.5px">Tes skills</div>
      <div id="sk-liste" style="margin-top:6px;max-height:170px;overflow:auto;font-size:14px"></div>
    </div>
  </div>
</div>


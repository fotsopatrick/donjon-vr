};

window.D = { THREE, scene, camera, renderer, lampe, lumieres, joueur, tete, mur, T, W, H,
             traiterChat, esprit, caseDevant, dirCardinale, voixDuMonde, basculerStatut,
             arme, armeDos, avatar, basculerVue,

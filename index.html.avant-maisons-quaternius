/* ═══════════════ 9 ter. LES ÉCRANS DE L'ISEKAI ═══════════════
   La fenêtre de statut et la Voix du Monde. Ce ne sont PAS des éléments
   plaqués sur l'écran : ce sont des panneaux qui flottent dans le donjon,
   à un mètre devant les yeux. C'est la seule forme qui tiendra en casque. */

/* Fabrique un panneau : un dessin fait au pinceau sur une toile, collé sur
   un rectangle qui flotte. La toile se redessine quand le contenu change. */
function fabriquerPanneau(largeurPx, hauteurPx, largeurM){
  const c = document.createElement('canvas');
  c.width = largeurPx; c.height = hauteurPx;
  const g = c.getContext('2d');
  const tex = new THREE.CanvasTexture(c);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.anisotropy = 4;
  const mesh = new THREE.Mesh(
    new THREE.PlaneGeometry(largeurM, largeurM * hauteurPx/largeurPx),
    new THREE.MeshBasicMaterial({ map:tex, transparent:true, opacity:1, depthTest:false,
      depthWrite:false, side:THREE.DoubleSide }));
  mesh.renderOrder = 999;         // toujours par-dessus la pierre
  mesh.visible = false;
  scene.add(mesh);
  return { c, g, tex, mesh };
}

/* le cadre bleu translucide, commun aux deux écrans */
function fondIsekai(g, w, h, teinte){
  g.clearRect(0,0,w,h);
  const d = g.createLinearGradient(0,0,0,h);
  d.addColorStop(0,   `rgba(${teinte},0.30)`);
  d.addColorStop(0.5, `rgba(${teinte},0.19)`);
  d.addColorStop(1,   `rgba(${teinte},0.30)`);
  g.fillStyle = d;
  g.fillRect(0,0,w,h);
  // liseré lumineux
  g.strokeStyle = `rgba(${teinte},0.95)`; g.lineWidth = 3;
  g.strokeRect(1.5,1.5,w-3,h-3);
  g.strokeStyle = `rgba(255,255,255,0.5)`; g.lineWidth = 1;
  g.strokeRect(9,9,w-18,h-18);
  // coins coupés, comme les interfaces d'anime
  g.fillStyle = `rgba(${teinte},1)`;
  for(const [x,y,sx,sy] of [[0,0,1,1],[w,0,-1,1],[0,h,1,-1],[w,h,-1,-1]]){
    g.beginPath();
    g.moveTo(x, y+28*sy); g.lineTo(x, y); g.lineTo(x+28*sx, y);
    g.lineTo(x+22*sx, y+6*sy); g.lineTo(x+6*sx, y+6*sy); g.lineTo(x+6*sx, y+22*sy);
    g.closePath(); g.fill();
  }
}


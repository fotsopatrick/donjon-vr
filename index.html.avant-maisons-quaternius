/* ═══ le cœur : ce que l'esprit comprend ═══
   Fidèle au jeu 2D — mêmes mots-clés, mêmes réponses, dans le même ordre. */
function traiterChat(texte){
  const t = normaliser(texte);
  if(!t) return;
  elEntendu.textContent = '« ' + texte.trim() + ' »';
  elEntendu.classList.remove('provisoire');
  elEsprit.classList.add('on');
  if(etat !== 'jeu'){ esprit("Le donjon dort encore. Descends d'abord."); return; }

  const devant = caseDevant();
  const surSol = dansGrille(devant) && grid[devant.y][devant.x] === FLOOR;

  // un skill que TU as créé (menu pause) : s'il est élémentaire, il agit ; sinon on le note
  const monSkill = (typeof lireSkills==='function' ? lireSkills() : []).find(sk => sk.inc && t.includes(sk.inc));
  if(monSkill){
    if(['feu','eau','vent'].includes(monSkill.elem)){ lancerProjectile(monSkill.elem); esprit('« '+monSkill.nom+' » ! '+(monSkill.effet||'')); }
    else esprit('« '+monSkill.nom+' » — pas encore rendu réel, mais je l\'ai noté.');
    return;
  }

  if(t.includes('feu') || t.includes('flamme')){
    lancerProjectile('feu'); esprit("System Call! Une boule de feu jaillit de ta main.");

  } else if(t.includes('eau') || t.includes('glace') || t.includes('vague')){
    lancerProjectile('eau'); esprit("System Call! Un trait d'eau file devant toi.");

  } else if(t.includes('vent') || t.includes('lame de vent') || t.includes('bourrasque')){
    lancerProjectile('vent'); esprit("System Call! Une lame de vent fend l'air.");

  } else if(t.includes('potion') || t.includes('soigne') || t.includes('vie')){
    if(joueur.vie < joueur.vieMax){ joueur.vie++; dessinerCoeurs(); esprit("Une potion apparaît dans ta main. Un cœur de plus."); }
    else esprit("Tes cœurs sont déjà pleins.");

  } else if(t.includes('epee') || t.includes('arme')){
    joueur.epee = true; sauvegarderPartie(); esprit("Tu brandis une épée enchantée. Un coup suffit désormais.");

  } else if(t.includes('coffre')){
    if(surSol && !coffre){ poserCoffre(devant.x, devant.y); esprit("Un coffre apparaît devant toi. Va l'ouvrir."); }
    else esprit("Pas de place ici pour un coffre.");

  } else if(t.includes('bouclier')){
    joueur.vieMax = 5; joueur.vie = Math.min(5, joueur.vie+2); dessinerCoeurs(); sauvegarderPartie();
    esprit("Un bouclier magique te protège. Deux cœurs de plus.");

  } else if(t.includes('cle')){
    joueur.cle = true; elCle.classList.add('ok');
    if(meshCle) meshCle.visible = false;
    esprit("La clé apparaît dans ta main. La porte t'attend.");

  } else if(t.includes('torche') || t.includes('lumiere') || t.includes('feu')){
    if(surSol){ allumerFeu(devant.x, devant.y); esprit("Une flamme s'élève devant toi."); }
    else esprit("Pas de place pour une flamme ici.");

  } else if(t.includes('piege')){
    if(surSol && !pieges.some(p=>p.x===devant.x && p.y===devant.y)){
      poserPiege(devant.x, devant.y);
      esprit(pouvoirs.includes('PIÈGE')
        ? "Des pointes jaillissent devant toi."
        : "Des pointes jaillissent. Reste à voir si elles servent à quelque chose.");
    } else esprit("Pas de place pour un piège ici.");

  } else if(t.includes('annul') || t.includes('retire') || t.includes('stop') || t.includes('des dupl')){
    jumeaux.forEach(j=>monde.remove(j.obj)); jumeaux = [];
    esprit("Tes jumeaux se dissipent.");

  } else if(t.includes('dupli') || t.includes('clone') || t.includes('jumeau')){
    if(jumeaux.length >= 3) esprit("Pas plus de trois toi-mêmes. L'espace-temps est fragile.");
    else if(poserJumeau()){
      esprit(pouvoirs.includes('DUPLICATION')
        ? "Un jumeau se matérialise à tes côtés."
        : "Un jumeau se matérialise. Garde-le en vie, on verra ce que tu vaux.");
      // l'épreuve : le tenir huit secondes sans mourir
      jumeauxDepuis = 0;
    }
    else esprit("Pas de place pour un jumeau ici.");

  } else if(t.includes('chemin') || t.includes('passage') || t.includes('route') || t.includes('tunnel')){
    const d = dirCardinale(), o = OFFSETS[d];
    let n = 0;
    for(let i=1;i<=4;i++){
      const tx = Math.floor(joueur.x/T)+o[0]*i, ty = Math.floor(joueur.z/T)+o[1]*i;
      if(tx<1||ty<1||tx>=W-1||ty>=H-1) break;
      if(grid[ty][tx]===WALL){ grid[ty][tx]=FLOOR; n++; }
    }
    if(n>0){ construireMurs(); esprit("J'ai percé un passage vers " + NOMS_DIR[d] + "."); }
    else esprit("Il n'y a rien à percer par là.");

  } else if(t.includes('brise') || t.includes('casse') || t.includes('detruit')){
    let d = directionDemandee(t); if(d<0) d = dirCardinale();
    const o = OFFSETS[d];
    let tx = Math.floor(joueur.x/T), ty = Math.floor(joueur.z/T), n = 0;
    // en 2D le joueur était emporté au bout de la percée ; en VR cela retourne
    // l'estomac, alors on perce sans le déplacer.
    for(;;){
      tx += o[0]; ty += o[1];
      if(tx<1||ty<1||tx>=W-1||ty>=H-1) break;
      const c = grid[ty][tx];
      if(c===WALL){ grid[ty][tx]=FLOOR; n++; }
      else if(c===DOOR) break;
    }
    if(n>0){
      construireMurs(); joueur.secousse = 0.7;
      esprit(n + " mur" + (n>1?"s":"") + " tombé" + (n>1?"s":"") + " vers " + NOMS_DIR[d] + ".");
      // l'épreuve : il faut avoir vraiment ouvert quelque chose, pas gratté un bloc
      if(n >= 2) debloquer('BRISE');
    } else esprit("Aucun mur à briser par là.");

  } else if(t.includes('mur') && (t.includes('debloc') || t.includes('ouvre'))){
    if(dansGrille(devant) && grid[devant.y][devant.x]===WALL){
      grid[devant.y][devant.x]=FLOOR; construireMurs(); joueur.secousse = 0.5;
      esprit("Le mur s'effondre. Passage libre.");
    } else esprit("Il n'y a pas de mur devant toi.");

  } else if(t.includes('mur')){
    if(surSol && !(coffre && coffre.x===devant.x && coffre.y===devant.y)){
      grid[devant.y][devant.x]=WALL; construireMurs();
      esprit("Un mur se dresse devant toi.");
    } else esprit("Pas de place pour un mur ici.");

  } else if(t.includes('devore') || t.includes('absorbe') || t.includes('mange')){
    if(!pouvoirs.includes('DÉVOREUR')){
      // il entend le mot, il ne le comprend pas encore
      esprit("Ces mots ne veulent rien dire pour toi. Pas encore.");
      return;
    }
    let proie = null, pd = 1e9;
    for(const e of ennemis){
      if(e.vie<=0) continue;
      const d2 = Math.hypot(e.x*T-joueur.x, e.y*T-joueur.z);
      if(d2 < 4.5 && d2 < pd){ pd = d2; proie = e; }
    }
    if(!proie){ esprit("Rien à dévorer à ta portée."); return; }
    proie.vie = 0; proie.mort = 0.55;
    if(joueur.vie < joueur.vieMax){ joueur.vie++; dessinerCoeurs(); }
    esprit("Tu l'absorbes. Ce qu'il était te revient.");
    bip(180,0.22,'sawtooth',0.09); bip(520,0.16,'sine',0.06,0.12);

  } else {
    // un pouvoir inventé par le joueur : il porte son nom, il fait ce qu'il a dit
    const inv = Object.keys(pouvoirsPerso).find(n=>t.includes(normaliser(n)));
    if(inv){ traiterChat(pouvoirsPerso[inv]); return; }
    esprit("Je n'ai pas compris. Essaie : une potion, une épée, un coffre, un chemin, un piège, brise les murs vers la gauche, je me duplique.");
  }
}


  g.beginPath(); g.moveTo(46,32); g.lineTo(38,12); g.lineTo(54,28); g.fill();   // cornes
  g.beginPath(); g.moveTo(82,32); g.lineTo(90,12); g.lineTo(74,28); g.fill();

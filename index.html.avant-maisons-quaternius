function estPalier(n){ return n > 0 && n % PALIER === 0; }

function creerBoss(tx, ty){
  const g = new THREE.Group();

  // le corps : une masse gélatineuse, plus sombre qu'un slime ordinaire
  const corps = new THREE.Mesh(
    new THREE.IcosahedronGeometry(1.45, 4),
    new THREE.MeshStandardMaterial({ color:0x1d6f96, emissive:0x0a3a52,
      emissiveIntensity:0.7, transparent:true, opacity:0.82,
      roughness:0.1, metalness:0.05 }));
  corps.position.y = 1.35;

  // le noyau : c'est lui qui bat, et qui vire au rouge quand la bête s'énerve
  const noyau = new THREE.Mesh(
    new THREE.IcosahedronGeometry(0.42, 2),
    new THREE.MeshBasicMaterial({ color:0x7fe3ff, transparent:true, opacity:0.9 }));
  noyau.position.y = 1.2;

  const oeilG = new THREE.Mesh(new THREE.SphereGeometry(0.2, 12, 12),
    new THREE.MeshBasicMaterial({ color:0x05070a }));
  oeilG.position.set(-0.5, 1.65, 1.2);
  const oeilD = oeilG.clone(); oeilD.position.x = 0.5;

  const lueur = new THREE.PointLight(0x4fc8ff, 14, 12, 1.7);
  lueur.position.y = 1.4;

  g.add(corps, noyau, oeilG, oeilD, lueur);
  g.position.set(tx*T+T/2, 0, ty*T+T/2);
  monde.add(g);

  // sa jauge de vie, un panneau qui le suit et te fait toujours face
  const jauge = fabriquerPanneau(760, 130, 1.9);
  jauge.mesh.visible = true;

  boss = {
    obj:g, corps, noyau, oeilG, oeilD, lueur, jauge,
    x: tx*T+T/2, z: ty*T+T/2,
    vie: 10 + niveau, vieMax: 10 + niveau,
    etat:'dort', cd:1.4, charge:0, enrage:false, mort:0, touche:0,
    nom: 'GARDIEN DU ' + niveau + 'ᵉ PALIER',
  };
  dessinerJauge();
}

function dessinerJauge(){
  if(!boss) return;
  const { g, c, tex } = boss.jauge;
  const w = c.width, h = c.height;
  const teinte = boss.enrage ? '255,110,90' : '120,190,255';
  fondIsekai(g, w, h, teinte);
  g.textAlign = 'center'; g.textBaseline = 'middle';
  g.font = '30px "Iowan Old Style", Georgia, serif';
  g.fillStyle = '#eaf4ff';
  g.fillText(boss.nom, w/2, 40);
  // la barre
  const bx = 46, bw = w - 92, by = 74, bh = 26;
  g.fillStyle = 'rgba(0,0,0,0.45)';
  g.fillRect(bx, by, bw, bh);
  const part = Math.max(0, boss.vie / boss.vieMax);
  const d = g.createLinearGradient(bx, 0, bx+bw, 0);
  if(boss.enrage){ d.addColorStop(0,'#ff5a3c'); d.addColorStop(1,'#ffb08a'); }
  else           { d.addColorStop(0,'#3fa8dc'); d.addColorStop(1,'#9fe4ff'); }
  g.fillStyle = d;
  g.fillRect(bx, by, bw*part, bh);
  g.strokeStyle = `rgba(${teinte},0.9)`; g.lineWidth = 2;
  g.strokeRect(bx, by, bw, bh);
  g.textAlign = 'left';

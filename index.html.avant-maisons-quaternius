             get grid(){ return grid; }, get ennemis(){ return ennemis; },
             get murIM(){ return murIM; }, get flammes(){ return flammes; },
             get etat(){ return etat; },
             /* régler l'épée en main à l'oeil : D.reglerEpee(rx, ry, rz, echelle) */
             sauver(){ sauvegarderPartie(); return 'partie sauvegardee'; },
             teinter(corps, tete){ const p = avatar.userData.persoFace; if(!p) return 'pas de perso';
               p.traverse(o=>{ if(o.isMesh && o.material && o.material.color){
                 const n=(o.name||'').toLowerCase();
                 o.material.color.setHex(/visor|head|face|tete/.test(n) ? (tete||0x6b4a34) : (corps||0x20242c)); }});
               return 'teinté'; },
             echelleProps(v){ return 'recharge un etage pour appliquer SCP='+v; },
             orienterPerso(rad){ const p = avatar.userData.persoFace; if(!p) return 'pas de perso';
               p.rotation.y = (rad!==undefined) ? rad : (p.rotation.y + Math.PI); return { rotation_y:+p.rotation.y.toFixed(2) }; },
             reglerFrappe(bras, avbras, buste, fente){
               if(bras!==undefined) FRAPPE.bras = bras;
               if(avbras!==undefined) FRAPPE.avbras = avbras;
               if(buste!==undefined) FRAPPE.buste = buste;
               if(fente!==undefined) FRAPPE.fente = fente;
               return { ...FRAPPE };
             },
             effacerSauvegarde(){ effacerPartie(); return 'sauvegarde effacee'; },
             reglerEpee(rx, ry, rz, ech){
               const em = avatar.userData.epeeMain;
               if(!em) return 'pas d epee en main (recharge en vue exterieure)';
               if(rx!==undefined) em.rotation.x = rx;
               if(ry!==undefined) em.rotation.y = ry;
               if(rz!==undefined) em.rotation.z = rz;
               if(ech!==undefined) em.scale.setScalar(em.userData.baseScale * ech);
               em.userData.base = { x:em.rotation.x, y:em.rotation.y, z:em.rotation.z };
               return { rx:+em.rotation.x.toFixed(2), ry:+em.rotation.y.toFixed(2),
                        rz:+em.rotation.z.toFixed(2), echelle:+(em.scale.x/em.userData.baseScale).toFixed(2) };
             } };


      g.userData.corps = corps;
    }
    const hauteurs = { slime:0.42, rat:0.22, squelette:0, spectre:0.35, paysan:0 };
    g.position.set(e.x*T, hauteurs[e.type] ?? 0.3, e.y*T);
    monde.add(g);
    e.obj = g; meshEnnemis.push(g);
  }
}


let espritT = 0;              // combien de temps le panneau reste affiché

function normaliser(t){
  return (t||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');
}

/* la case juste devant le joueur, d'après là où il regarde */
function dirCardinale(){
  // 0 = nord (-z), 1 = est (+x), 2 = sud (+z), 3 = ouest (-x)
  return ((Math.round(-joueur.lacet/(Math.PI/2)) % 4) + 4) % 4;
}
const OFFSETS = [[0,-1],[1,0],[0,1],[-1,0]];
const NOMS_DIR = ["le nord","l'est","le sud","l'ouest"];
function caseDevant(){
  const o = OFFSETS[dirCardinale()];
  return { x: Math.floor(joueur.x/T) + o[0], y: Math.floor(joueur.z/T) + o[1] };
}
function dansGrille(c){ return c.x>=1 && c.y>=1 && c.x<W-1 && c.y<H-1; }
function directionDemandee(t){
  if(/\bgauche\b|\bouest\b/.test(t)) return 3;
  if(/\bdroite\b|\best\b/.test(t))   return 1;
  if(/\bhaut\b|\bnord\b/.test(t))    return 0;
  if(/\bbas\b|\bsud\b/.test(t))      return 2;
  return -1;
}

/* ---- la voix de l'esprit ---- */
let voixFr = null;
function choisirVoix(){
  const v = speechSynthesis.getVoices();
  voixFr = v.find(x=>/^fr/i.test(x.lang) && /grave|homme|male|thomas/i.test(x.name))
        || v.find(x=>/^fr/i.test(x.lang)) || null;
}
if(window.speechSynthesis){
  choisirVoix();
  speechSynthesis.onvoiceschanged = choisirVoix;
}
function esprit(m, muet=false){
  elRepond.textContent = m;
  elEsprit.classList.add('on');
  espritT = 5.5;
  if(!muet && window.speechSynthesis){
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(m);
    if(voixFr) u.voice = voixFr;
    u.lang = 'fr-FR'; u.pitch = 0.55; u.rate = 0.97; u.volume = 0.85;
    speechSynthesis.speak(u);
  }
}

/* ---- les objets que l'esprit fait apparaître ---- */
function allumerFeu(tx, ty){
  const wx = tx*T+T/2, wz = ty*T+T/2;
  const socle = new THREE.Mesh(
    new THREE.CylinderGeometry(0.26, 0.34, 0.3, 8),
    new THREE.MeshStandardMaterial({ color:0x171310, roughness:0.9, metalness:0.4 }));
  socle.position.set(wx, 0.15, wz);
  monde.add(socle);
  const fl = new THREE.Sprite(new THREE.SpriteMaterial({
    map:texFlamme, color:0xffb04a, blending:THREE.AdditiveBlending,
    depthWrite:false, transparent:true, opacity:0.95 }));
  fl.position.set(wx, 0.62, wz);
  fl.scale.set(0.8, 1.1, 1);
  monde.add(fl);
  const ph = Math.random()*6;
  flammes.push({ sp:fl, ph, x:wx, z:wz });
  torches.push({ x:tx, y:ty, wx, wz, ph });    // elle entre dans le tour des 6 lumières
}

function poserCoffre(tx, ty){
  const g = new THREE.Group();
  const caisse = new THREE.Mesh(new THREE.BoxGeometry(0.7,0.45,0.5),
    new THREE.MeshStandardMaterial({ color:0x4a331f, roughness:0.85 }));
  caisse.position.y = 0.22;
  const couvercle = new THREE.Mesh(new THREE.BoxGeometry(0.74,0.16,0.54),
    new THREE.MeshStandardMaterial({ color:0x5c4026, roughness:0.8 }));
  couvercle.position.y = 0.52;
  const ferrure = new THREE.Mesh(new THREE.BoxGeometry(0.78,0.07,0.07),
    new THREE.MeshStandardMaterial({ color:0xc9a227, roughness:0.35, metalness:0.9,
      emissive:0x5a4410, emissiveIntensity:0.5 }));
  ferrure.position.y = 0.45;
  g.add(caisse, couvercle, ferrure);
  g.position.set(tx*T+T/2, 0, ty*T+T/2);
  monde.add(g);
  coffre = { obj:g, couvercle, x:tx, y:ty, ouvert:false };
}

function poserPiege(tx, ty){
  const g = new THREE.Group();
  const mat = new THREE.MeshStandardMaterial({ color:0xb8b4aa, roughness:0.35, metalness:0.8,
    emissive:0x221a08, emissiveIntensity:0.4 });
  for(let i=0;i<5;i++){
    const p = new THREE.Mesh(new THREE.ConeGeometry(0.07, 0.5, 5), mat);
    const a = i*1.256;
    p.position.set(Math.cos(a)*0.35, 0.25, Math.sin(a)*0.35);
    g.add(p);
  }
  g.position.set(tx*T+T/2, 0, ty*T+T/2);
  g.scale.y = 0.05;                    // il jaillit
  monde.add(g);
  pieges.push({ obj:g, x:tx, y:ty, sortie:0 });
}

function poserJumeau(){
  // à deux cases de toi, sur du sol libre
  for(const [ox,oz] of [[2,0],[-2,0],[0,2],[0,-2],[2,2],[-2,-2]]){
    const x = joueur.x + ox*T*0.5, z = joueur.z + oz*T*0.5;
    if(mur(x,z)) continue;
    const g = new THREE.Group();
    const mat = new THREE.MeshStandardMaterial({ color:0x8fd0ff, emissive:0x2a6f9e,
      emissiveIntensity:0.9, transparent:true, opacity:0.42, roughness:0.2 });
    const corps = new THREE.Mesh(new THREE.CapsuleGeometry(0.24, 0.7, 4, 10), mat);
    corps.position.y = 0.85;
    const tete = new THREE.Mesh(new THREE.SphereGeometry(0.2, 10, 10), mat);
    tete.position.y = 1.42;
    const lueur = new THREE.PointLight(0x6cc4ff, 4.5, 5, 1.8);
    lueur.position.y = 1.1;
    g.add(corps, tete, lueur);
    g.position.set(x, 0, z);
    monde.add(g);
    jumeaux.push({ obj:g, dx:x-joueur.x, dz:z-joueur.z });
    return true;
  }
  return false;
}

/* ---- les pouvoirs débloqués ---- */
const DECLENCHEUR = {
  "BRISE": "brise les murs",
  "DUPLICATION": "je me duplique",
  "PIÈGE": "crée un piège",
};
let pouvoirs = [], pouvoirsPerso = {};

/* ═══════════════ 9 quater. LES GARDIENS DE PALIER ═══════════════
   Tous les PALIER étages, la clé ne traîne plus par terre : quelqu'un la garde.
   Trois façons de te faire mal — il charge, il frappe le sol, il crache ses
   rejetons — et il change de tempérament à mi-vie.                        */

const PALIER = 5;
let boss = null, ondes = [], cleVerrouillee = false, bossSalle = null, eclats = 0;
let projectiles = [];   // boules de feu, jets d'eau, lames de vent
let guerrier = null;   // le guerrier qu'on défie à l'étage 1

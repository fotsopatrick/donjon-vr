const MODELES = {};
let ANIM_PERSO = [], ANIM_PERSO_CUSTOM = [], ANIM_MAGE = [];
let modelesPrets = false;

/* Le ciel photographié. C'est une seule image projetée autour du monde :
   elle ne coûte RIEN à calculer — pas de géométrie, pas de lumière — et elle
   apporte des nuages réels, des reliefs au loin, une vraie profondeur.
   C'est le principe des visites virtuelles d'appartement, appliqué au fond.

   On le met en FOND seulement. S'en servir aussi pour éclairer la scène
   (`scene.environment`) coûterait cher : mesuré à −40 % d'images/seconde. */
let cielReel = null;
function chargerCiel(){
  return new Promise(res=>{
    new RGBELoader().load('assets/polyhaven/ciel-montagne.hdr',
      tex=>{ tex.mapping = THREE.EquirectangularReflectionMapping; cielReel = tex; res(); },
      undefined,
      ()=>{ console.warn('ciel introuvable — on garde le dégradé peint'); res(); });
  });
}

async function chargerModeles(){
  chargerCiel();                     // en parallèle, sans bloquer
  const loader = new GLTFLoader();
  const noms = Object.keys(A_CHARGER);
  await Promise.all(noms.map(nom => new Promise(res=>{
    loader.load(A_CHARGER[nom],
      gltf => { MODELES[nom] = gltf.scene;
                gltf.scene.userData.anims = gltf.animations || [];
                if(nom === 'perso') ANIM_PERSO = gltf.animations || [];
                if(nom === 'persoCustom') ANIM_PERSO_CUSTOM = gltf.animations || [];
                if(nom === 'animGeneralK' || nom === 'animMoveK' || nom === 'animSuper') ANIM_MAGE = ANIM_MAGE.concat(gltf.animations || []);
                res(); },
      undefined,
      () => { console.warn('modèle absent :', A_CHARGER[nom]); res(); });
  })));

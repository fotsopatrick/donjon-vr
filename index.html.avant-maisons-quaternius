/* ═══════════════ 5 bis. LA MANETTE ═══════════════
   Le navigateur lit les manettes sans rien installer. C'est la même interface
   (Gamepad) que celle des manettes du casque : ce qu'on écrit ici resservira.

   Stick gauche : marcher      ·  Stick droit : regarder
   A : frapper                 ·  B : foncer
   X : parler à l'esprit (maintenu)  ·  Y : la fenêtre de statut
   Gâchette droite : frapper   ·  Gâchette gauche : courir              */

let manetteVue = false;
const boutonsAvant = {};

function zoneMorte(v, seuil = 0.18){
  return Math.abs(v) < seuil ? 0 : (v - Math.sign(v)*seuil) / (1 - seuil);
}

function lireManette(dt){
  const pads = navigator.getGamepads ? navigator.getGamepads() : [];
  let p = null;
  for(const g of pads) if(g && g.connected){ p = g; break; }
  if(!p){ manetteVue = false; return null; }
  if(!manetteVue){
    manetteVue = true;
    dire('Manette « ' + p.id.slice(0, 28) + ' » reconnue.', 3);
  }

  const ax = zoneMorte(p.axes[0] ?? 0), ay = zoneMorte(p.axes[1] ?? 0);
  const rx = zoneMorte(p.axes[2] ?? 0, 0.14), ry = zoneMorte(p.axes[3] ?? 0, 0.14);

  // regarder : vitesse proportionnelle, au carré pour la précision au centre
  if(rx || ry){
    joueur.lacet   -= rx*Math.abs(rx) * 3.4 * dt;
    joueur.tangage -= ry*Math.abs(ry) * 2.6 * dt;
    joueur.tangage = Math.max(-1.35, Math.min(1.35, joueur.tangage));
  }

  const appui = (i)=> !!(p.buttons[i] && p.buttons[i].pressed);
  const neuf  = (i)=>{ const a = appui(i), b = boutonsAvant[i]; boutonsAvant[i] = a; return a && !b; };

  if(neuf(0) || neuf(7)) frapper();                 // A, gâchette droite
  if(neuf(1)){                                      // B : foncer
    if(!joueur.dx && !joueur.dz){
      joueur.dx = -Math.sin(joueur.lacet); joueur.dz = -Math.cos(joueur.lacet);
    }
    if(joueur.dashCd <= 0 && joueur.dash <= 0){
      joueur.dash = 0.17; joueur.dashCd = 0.85;
      joueur.secousse = Math.max(joueur.secousse, 0.25);
      bip(420,0.09,'sine',0.05);
    }
  }
  if(neuf(3)) basculerStatut();                     // Y
  // X maintenu : l'esprit écoute tant qu'on appuie
  const x = appui(2);
  if(x && !boutonsAvant.__x) ouvrirOreilles();
  if(!x && boutonsAvant.__x) fermerOreilles();
  boutonsAvant.__x = x;

  return { ax, ay, court: appui(6) || appui(4) };    // gâchette/bouton gauche : courir
}


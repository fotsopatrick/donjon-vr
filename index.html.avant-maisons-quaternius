/* Fond tous les morceaux d'un groupe qui partagent la même matière en un seul
   objet. Une maison à colombages passe ainsi de quarante poutres dessinées
   séparément à trois ou quatre blocs — c'est ce que la carte graphique compte,
   et c'est ce qui la fait plier. Ce qu'on voit à l'écran est identique. */
function fondre(groupe){
  const parMatiere = new Map();
  groupe.updateMatrixWorld(true);
  const inverse = groupe.matrixWorld.clone().invert();
  const morceaux = [];
  groupe.traverse(o=>{
    if(!o.isMesh || o.isInstancedMesh || o.userData.estContour) return;
    morceaux.push(o);
  });
  for(const o of morceaux){
    if(!parMatiere.has(o.material)) parMatiere.set(o.material, []);
    const g = o.geometry.clone();
    g.applyMatrix4(inverse.clone().multiply(o.matrixWorld));
    parMatiere.get(o.material).push(g);
  }
  for(const o of morceaux) o.parent && o.parent.remove(o);

  for(const [matiere, geos] of parMatiere){
    if(!geos.length) continue;
    let g;
    try { g = geos.length === 1 ? geos[0] : mergeGeometries(geos, false); }
    catch(e){ g = geos[0]; }
    if(!g) continue;
    const m = new THREE.Mesh(g, matiere);
    m.castShadow = true; m.receiveShadow = true;
    groupe.add(m);
  }
  return groupe;
}

/* Pose N copies d'un modèle en UNE SEULE fournée.
   C'est le geste décisif : cent arbres posés un par un font cent appels de
   dessin ; posés ainsi, ils en font un seul par morceau du modèle. Sur une
   carte intégrée, c'est la difference entre 23 et 60 images par seconde. */
function semer(nom, places){
  const modele = MODELES[nom];
  if(!modele || !places.length) return null;
  const groupe = new THREE.Group();
  const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
  const p = new THREE.Vector3(), sc = new THREE.Vector3();

  modele.updateMatrixWorld(true);
  modele.traverse(o=>{
    if(!o.isMesh) return;
    const mat = o.material.clone();
    if(mat.metalness !== undefined){ mat.metalness = 0; mat.roughness = 0.85; }
    if(mat.color && mat.color.g > 0.45 && mat.color.r < 0.45) mat.color.setHex(0x3f7d2e);

    const im = new THREE.InstancedMesh(o.geometry, mat, places.length);
    const local = o.matrixWorld.clone();
    places.forEach((pl, i)=>{
      e.set(0, pl.rot || 0, 0);
      q.setFromEuler(e);
      p.set(pl.x, pl.y || 0, pl.z);
      sc.setScalar(pl.ech || 1);
      m4.compose(p, q, sc).multiply(local);
      im.setMatrixAt(i, m4);
    });
    im.instanceMatrix.needsUpdate = true;
    im.castShadow = true;
    im.receiveShadow = true;
    groupe.add(im);
  });
  return groupe;
}

/* Pose une copie d'un modèle. Renvoie null si le modèle manque — l'appelant
   retombe alors sur la forme faite à la main. */
/* Les feuillages du Nature Kit tirent au turquoise (#70e6d6) : joli seul,
   mais il jure avec notre herbe. On les ramène vers un vert de forêt, avec
   une variation par arbre pour qu'ils ne soient pas tous identiques. */
const VERTS = [0x3f7d2e, 0x4c8f34, 0x356b2a, 0x5a9c3c, 0x2f6326];
function reteinter(g, graine){
  const vert = VERTS[graine % VERTS.length];
  g.traverse(o=>{
    if(!o.isMesh || !o.material || !o.material.color) return;
    // Les modèles Kenney sont réglés « métal pur » (metalness 1). Sans ciel
    // réfléchi, un métal ne renvoie rien : il devient NOIR. On les remet en
    // matière mate, ce qu'ils auraient dû être.
    if(o.material.metalness !== undefined){
      o.material.metalness = 0;
      o.material.roughness = 0.85;
    }
    const c = o.material.color;
    // un feuillage = beaucoup de vert, peu de rouge
    if(c.g > 0.45 && c.r < 0.45){
      o.material.color.setHex(vert);
      o.material.color.offsetHSL(0, 0, (Math.random()-0.5)*0.06);
    }
  });
}

function poser(nom, x, y, z, echelle = 1, rotY = 0){
  const m = MODELES[nom];
  if(!m) return null;
  const g = m.clone(true);
  g.traverse(o=>{ if(o.isMesh) o.material = o.material.clone(); });
  reteinter(g, (x*7 + z*13) | 0);
  g.position.set(x, y, z);
  g.rotation.y = rotY;
  g.scale.setScalar(echelle);
  return g;
}

/* ═══════════════ 1 ter. LES VRAIES MATIÈRES ═══════════════
   Des photographies de matière (Poly Haven, domaine public), posées sur des
   formes simples. C'est le compromis mesuré : la pierre a l'air de pierre,
   mais on n'a pas le calcul photoréaliste par pixel qui divisait par deux le
   débit d'images sur une carte intégrée.

   On utilise MeshLambertMaterial et non MeshStandard : l'éclairage y est
   calculé par sommet et non par pixel. C'est ce qui garde 60 images/seconde. */

const chargeurTex = new THREE.TextureLoader();
const MATIERES = {};

function matiere(nom, repeteX = 1, repeteY = 1){
  const cle = nom + repeteX + 'x' + repeteY;
  if(MATIERES[cle]) return MATIERES[cle];
  const t = chargeurTex.load('assets/textures/' + nom + '.jpg');
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(repeteX, repeteY);
  t.colorSpace = THREE.SRGBColorSpace;
  t.anisotropy = 4;
  MATIERES[cle] = t;
  return t;
}

/* une matière simple, éclairée par sommet : rapide et suffisante */
function mat(nom, repeteX = 1, repeteY = 1, teinte = 0xffffff){
  return new THREE.MeshLambertMaterial({ map: matiere(nom, repeteX, repeteY), color: teinte });
}

/* ═══════════════ 1 bis. LE DEHORS ═══════════════
   L'étage 0. Ce n'est pas un donjon : c'est une prairie fermée par une
   palissade, avec deux maisons, quelques arbres, et l'escalier qui descend.
   On réutilise la même grille que les étages — tout est « sol » sauf le
   pourtour et l'emprise des maisons — donc les collisions marchent sans une
   ligne de code en plus. */

/* ── LE PLAN DU VILLAGE ──
   Une rue principale nord-sud (x = 13) qui descend vers l'escalier du donjon,
   une rue est-ouest qui la croise à la place, et douze feux répartis le long
   des deux. Rien n'est aligné, les tailles varient : c'est l'irrégularité qui
   fait qu'un village a l'air d'un village et non d'un lotissement.

   `sens` dit de quel côté la façade regarde (vers la rue).
   `etage` ajoute un niveau, `chaume` remplace les tuiles par du chaume. */
const MAISONS = [
  // le long de la rue principale, côté ouest
  { x:9,  y:3,  w:3, h:3, sens: 1, etage:true  },
  { x:9,  y:8,  w:3, h:2, sens: 1 },
  { x:9,  y:12, w:3, h:3, sens: 1, chaume:true },
  // côté est
  { x:16, y:3,  w:3, h:2, sens:-1, chaume:true },
  { x:16, y:7,  w:3, h:3, sens:-1, etage:true  },
  { x:16, y:12, w:3, h:3, sens:-1 },
  // en retrait, le long de la rue transversale
  { x:3,  y:6,  w:3, h:3, sens: 1 },
  { x:3,  y:12, w:2, h:2, sens: 1, chaume:true },
  { x:22, y:5,  w:3, h:3, sens:-1, chaume:true },
  { x:22, y:11, w:3, h:2, sens:-1 },
  // deux fermes isolées, au nord
  { x:5,  y:2,  w:2, h:2, sens: 1, chaume:true },
  { x:20, y:2,  w:2, h:2, sens:-1 },
];

/* les rues : des bandes pavées. {x,y,w,h} en cases. */
const RUES = [
  { x:12, y:1,  w:2, h:16 },   // la principale, nord-sud
  { x:1,  y:8,  w:26, h:2 },   // la transversale, est-ouest
];
let arbres = [], entree = null, villageois = [];

function genererDehors(){
  grid = [];
  for(let y=0;y<H;y++){
    const ligne = new Array(W).fill(FLOOR);
    ligne[0] = WALL; ligne[W-1] = WALL;
    grid.push(ligne);
  }
  for(let x=0;x<W;x++){ grid[0][x] = WALL; grid[H-1][x] = WALL; }

  // les maisons sont des blocs pleins : on les contourne, on n'entre pas
  for(const m of MAISONS)
    for(let y=m.y;y<m.y+m.h;y++)
      for(let x=m.x;x<m.x+m.w;x++)
        if(y>0 && y<H-1 && x>0 && x<W-1) grid[y][x] = WALL;

  // les arbres : jamais sur une rue, ni devant une façade, ni sur la place
  arbres = [];
  const surUneRue = (x, y)=> RUES.some(r=> x>=r.x && x<r.x+r.w && y>=r.y && y<r.y+r.h);
  for(let i=0;i<40;i++){
    const x = 1 + (Math.random()*(W-2)|0), y = 1 + (Math.random()*(H-2)|0);
    if(grid[y][x] !== FLOOR) continue;
    if(surUneRue(x, y)) continue;
    if(Math.abs(x-13) < 4 && Math.abs(y-16) < 3) continue;   // la place de l'escalier
    let colle = false;
    for(const m of MAISONS)
      if(x > m.x-2 && x < m.x+m.w+2 && y > m.y-2 && y < m.y+m.h+2) colle = true;
    if(colle) continue;
    arbres.push({ x, y, h:1 + Math.random()*0.6, r:Math.random()*3 });
  }

  // l'escalier vers le donjon : au bout de la rue principale, au sud
  entree = { x:13, y:16 };
  doorPos = { x:entree.x, y:entree.y };
  keyPos = null;
  torches = [];
  ennemis = [];
  cleVerrouillee = false;
  bossSalle = null;
  rooms = [{ x:12, y:10, w:2, h:2 }];       // on apparaît sur la place
  return { x:13, y:10 };
}

/* ═══════════════ 2 bis. LE STYLE — CEL-SHADING ═══════════════
   C'est la technique des jeux d'animation japonais, Genshin compris. Deux
   idées, et aucune image :

   1. La lumière ne fond pas en dégradé : elle tombe par PALIERS. Une zone
      claire, une zone moyenne, une zone d'ombre, et rien entre les deux.
      C'est ça qui donne l'aspect « dessiné » plutôt que « photographié ».
   2. Chaque objet porte un CONTOUR noir. On l'obtient en dessinant une copie
      de l'objet, gonflée le long de ses normales, à l'envers : seul le
      pourtour dépasse, et il fait le trait.

   Bonus : c'est moins cher qu'un rendu réaliste. */

/* les paliers de lumière : quatre marches, sans lissage */
function nuancierToon(marches = 4){
  const d = new Uint8Array(marches);
  for(let i=0;i<marches;i++) d[i] = Math.round((i/(marches-1)) * 255);
  const t = new THREE.DataTexture(d, marches, 1, THREE.RedFormat);
  t.minFilter = t.magFilter = THREE.NearestFilter;   // surtout pas de lissage
  t.needsUpdate = true;
  return t;
}
const NUANCIER = nuancierToon(4);

/* transforme une matière ordinaire en matière dessinée */
function enToon(mat){
  const m = new THREE.MeshToonMaterial({
    color: mat.color ? mat.color.clone() : new THREE.Color(0xffffff),
    map: mat.map || null,
    gradientMap: NUANCIER,
    transparent: mat.transparent || false,
    opacity: mat.opacity !== undefined ? mat.opacity : 1,
    side: mat.side || THREE.FrontSide,
    emissive: mat.emissive ? mat.emissive.clone() : new THREE.Color(0x000000),
    emissiveIntensity: mat.emissiveIntensity || 0,
    vertexColors: !!mat.vertexColors,   // sans ça, les modèles importés sortent blancs
  });
  return m;
}

/* le contour : une coque retournée, gonflée le long des normales */
function matiereContour(epaisseur = 0.012){
  return new THREE.ShaderMaterial({
    uniforms: { epaisseur: { value: epaisseur } },
    vertexShader: `
      uniform float epaisseur;
      void main(){
        vec3 pousse = position + normal * epaisseur;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pousse, 1.0);
      }`,
    fragmentShader: `
      void main(){ gl_FragColor = vec4(0.02, 0.03, 0.06, 1.0); }`,
    side: THREE.BackSide,
    depthWrite: true,
  });
}

/* pose un contour sur tous les volumes d'un groupe */
function cerner(racine, epaisseur = 0.014){
  const aAjouter = [];
  racine.traverse(o=>{
    if(!o.isMesh || o.userData.estContour) return;
    if(o.material && o.material.transparent && o.material.opacity < 0.6) return; // pas sur le translucide
    aAjouter.push(o);
  });
  for(const o of aAjouter){
    const c = new THREE.Mesh(o.geometry, matiereContour(epaisseur));
    c.userData.estContour = true;
    c.renderOrder = -1;
    o.add(c);
  }
  return racine;
}

/* Convertit tout un groupe au style dessiné, puis pose les contours.
   Le cache évite de refabriquer dix fois la même matière partagée. */
const cacheToon = new Map();
function styliser(racine, epaisseur = 0.014){
  racine.traverse(o=>{
    if(!o.isMesh || o.userData.estContour) return;
    // les volumes projettent leur ombre et la reçoivent ; les contours, non
    o.castShadow = true;
    o.receiveShadow = true;
    if(o.isInstancedMesh) {            // les murs : on convertit, mais pas de contour
      if(o.material && o.material.isMeshStandardMaterial){
        let t = cacheToon.get(o.material);
        if(!t){ t = enToon(o.material); cacheToon.set(o.material, t); }
        o.material = t;
      }
      return;
    }
    if(o.material && o.material.isMeshStandardMaterial){
      let t = cacheToon.get(o.material);
      if(!t){ t = enToon(o.material); cacheToon.set(o.material, t); }
      o.material = t;
    }
  });
  if(epaisseur > 0) cerner(racine, epaisseur);
  return racine;
}


function cleSkills(){ return 'kotoage-skills-' + (typeof joueurNom!=='undefined'?joueurNom:'Patrick'); }
function lireSkills(){ try{ return JSON.parse(localStorage.getItem(cleSkills())||'[]'); }catch(e){ return []; } }
function ecrireSkills(a){ try{ localStorage.setItem(cleSkills(), JSON.stringify(a)); }catch(e){} }
function rafraichirSkills(){
  const l = lireSkills(), box = document.getElementById('sk-liste');
  box.innerHTML = l.length ? l.map((s,i)=>`<div style="padding:6px 0;border-bottom:1px solid #1c2636">
    <b style="color:#eaf0f8">${s.nom}</b> <span style="color:#8fb8e8">[${s.elem}]</span>
    <span style="color:#6b7d93">· dis « ${s.inc} »</span>
    <button data-i="${i}" class="sk-suppr" style="float:right;background:#3a1414;color:#ffb4b4;border:0;border-radius:6px;padding:2px 8px;cursor:pointer">✕</button>
    <div style="color:#9fb2cc;font-size:12px">${s.effet||''}</div></div>`).join('') : '<div style="color:#6b7d93">Aucun skill pour l\'instant.</div>';
  box.querySelectorAll('.sk-suppr').forEach(b=>b.onclick=()=>{ const a=lireSkills(); a.splice(+b.dataset.i,1); ecrireSkills(a); rafraichirSkills(); });
}

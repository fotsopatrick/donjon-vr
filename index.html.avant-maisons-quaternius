  braises = new THREE.Points(new THREE.BufferGeometry().setAttribute('position',
    new THREE.BufferAttribute(new Float32Array(3), 3)),
    new THREE.PointsMaterial({ size:0.01, transparent:true, opacity:0 }));
  braises.userData = [];
  monde.add(braises);

  // quelques graines de pollen dans la lumière
  const NB = 260, pos = new Float32Array(NB*3), don = [];
  for(let i=0;i<NB;i++)
    don.push({ x:Math.random()*W*T, y:Math.random()*5, z:Math.random()*H*T,
               v:0.05+Math.random()*0.12, ph:Math.random()*6 });
  poussiere = new THREE.Points(

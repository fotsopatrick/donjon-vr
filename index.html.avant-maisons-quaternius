let annonceT = 0;

function voixDuMonde(texte, parler=true){
  const { g, c, tex, mesh } = annonce;
  const w = c.width, h = c.height;
  fondIsekai(g, w, h, OR);
  g.textBaseline = 'middle';
  g.textAlign = 'center';
  g.font = '34px "Iowan Old Style", Georgia, serif';
  g.fillStyle = '#fff6e0';
  // on coupe en deux lignes si c'est long
  const mots = texte.split(' ');
  let l1 = '', l2 = '';
  for(const m of mots){
    if(g.measureText(l1 + ' ' + m).width < w-140 && !l2) l1 += (l1?' ':'') + m;
    else l2 += (l2?' ':'') + m;
  }
  if(l2){ g.fillText('《 ' + l1, w/2, h/2 - 24); g.fillText(l2 + ' 》', w/2, h/2 + 24); }
  else   { g.fillText('《 ' + l1 + ' 》', w/2, h/2); }
  g.textAlign = 'left';
  tex.needsUpdate = true;

  mesh.renderOrder = 1000;              // toujours devant la fenêtre de statut
  mesh.visible = true;
  placerDevant(mesh, 1.5, 0.80);
  annonceT = 5.0;

  bip(1046, 0.09, 'sine', 0.06); bip(1568, 0.14, 'sine', 0.05, 0.09);

  if(parler && window.speechSynthesis){
    const u = new SpeechSynthesisUtterance(texte);
    if(voixFr) u.voice = voixFr;
    u.lang = 'fr-FR';
    u.pitch = 1.15; u.rate = 1.02; u.volume = 0.8;   // neutre, sans chaleur
    speechSynthesis.speak(u);
  }
}


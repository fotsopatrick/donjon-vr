const joueur = { x:0, z:0, vie:3, vieMax:3, cle:false, lacet:0, tangage:0,
                 roulis:0, pas:0, inv:0, atkCd:0, secousse:0, souffle:0,
                 dash:0, dashCd:0, dx:0, dz:0, epee:false,
                 combo:0, comboT:0, saut:0, vy:0 };
const RAYON = 0.42;                     // il ne passe pas dans les murs

function mur(wx, wz){
  const tx = Math.floor(wx/T), ty = Math.floor(wz/T);
  if(tx<0||ty<0||tx>=W||ty>=H) return true;
  return grid[ty][tx]===WALL;
}
function glisser(x, z, dx, dz){
  // on essaie chaque axe séparément : on longe le mur au lieu de coller
  let nx = x + dx, nz = z + dz;
  if(mur(nx+Math.sign(dx)*RAYON, z)) nx = x;
  if(mur(x, nz+Math.sign(dz)*RAYON)) nz = z;
  if(!mur(nx+Math.sign(dx)*RAYON, nz+Math.sign(dz)*RAYON) || nx===x || nz===z) return {x:nx,z:nz};
  return {x:nx, z:z};
}


<script type="module">
import * as THREE from './three.module.js';
import { GLTFLoader } from './jsm/loaders/GLTFLoader.js';
import { mergeGeometries } from './jsm/utils/BufferGeometryUtils.js';
import { RGBELoader } from './jsm/loaders/RGBELoader.js';

/* ═══════════════ 1. LE PLAN — repris tel quel du jeu 2D ═══════════════ */
const W = 28, H = 18;                 // la grille, en cases
const WALL = 0, FLOOR = 1, DOOR = 2, KEY = 3;
const T  = 2.6;                       // largeur d'une case, en mètres
const HT = 9.0;                       // plafond très haut : taille dragon

let grid, rooms, keyPos, doorPos, torches, ennemis, niveau = 1;

/* Cinq étages, cinq ambiances. Le premier est court exprès : on doit pouvoir
   descendre en deux minutes, pas errer. */
const ETAGES = [
  { salles:4, faune:['slime'],                 teinte:0xffa64a, nom:'les caves' },   // ambre chaud (torche), plus de bleu
  { salles:5, faune:['paysan','paysan','squelette','slime'],       teinte:0x9d7bff, nom:'l\'ossuaire' },
  { salles:6, faune:['rat','rat','paysan','squelette'],             teinte:0x36d6a8, nom:'les galeries' },
  { salles:6, faune:['spectre','spectre','squelette'],             teinte:0xff8ad4, nom:'le voile' },
  { salles:7, faune:['slime','rat','squelette'],teinte:0xff6a48, nom:'le palier' },
];
const DEHORS = { salles:0, faune:[], teinte:0xffd98a, nom:'le hameau' };
function estDehors(){ return niveau === 0; }
function etageCourant(){
  if(estDehors()) return DEHORS;
  return ETAGES[Math.min(niveau, ETAGES.length) - 1];
}

const cX = r => Math.floor(r.x + r.w / 2);
const cY = r => Math.floor(r.y + r.h / 2);
function creuserSalle(r){ for(let y=r.y;y<r.y+r.h;y++) for(let x=r.x;x<r.x+r.w;x++) grid[y][x]=FLOOR; }
function creuserH(x1,x2,y){ for(let x=Math.min(x1,x2);x<=Math.max(x1,x2);x++){ grid[y][x]=FLOOR; if(y+1<H-1) grid[y+1][x]=FLOOR; if(y-1>0) grid[y-1][x]=FLOOR; } }
function creuserV(y1,y2,x){ for(let y=Math.min(y1,y2);y<=Math.max(y1,y2);y++){ grid[y][x]=FLOOR; if(x+1<W-1) grid[y][x+1]=FLOOR; if(x-1>0) grid[y][x-1]=FLOOR; } }
function posLibre(r){
  for(let y=r.y;y<r.y+r.h;y++) for(let x=r.x;x<r.x+r.w;x++) if(grid[y][x]===FLOOR) return {x,y};
  return {x:cX(r), y:cY(r)};
}

function generer(){
  grid = [];
  for(let y=0;y<H;y++) grid.push(new Array(W).fill(WALL));
  rooms = [];
  const reglage = etageCourant();
  for(let i=0;i<120 && rooms.length<reglage.salles;i++){
    const rw = 7 + (Math.random()*5|0), rh = 6 + (Math.random()*4|0);   // salles vastes (taille dragon)
    const r = { x:1+(Math.random()*(W-rw-2)|0), y:1+(Math.random()*(H-rh-2)|0), w:rw, h:rh };
    let ok = true;
    for(const o of rooms)
      if(r.x<o.x+o.w+2 && r.x+r.w+2>o.x && r.y<o.y+o.h+2 && r.y+r.h+2>o.y){ ok=false; break; }
    if(ok){ rooms.push(r); creuserSalle(r); }
  }
  if(rooms.length<3){ generer(); return; }
  for(let i=1;i<rooms.length;i++){
    const a=rooms[i-1], b=rooms[i];
    const ax=cX(a), ay=cY(a), bx=cX(b), by=cY(b);
    if(Math.random()<0.5){ creuserH(ax,bx,ay); creuserV(ay,by,bx); }
    else               { creuserV(ay,by,ax); creuserH(ax,bx,by); }
  }
  const k = posLibre(rooms[rooms.length-1]); keyPos  = {x:k.x,y:k.y}; grid[k.y][k.x]=KEY;
  // aux paliers, personne ne ramasse la clé : quelqu'un la garde
  cleVerrouillee = estPalier(niveau);
  bossSalle = cleVerrouillee ? { x:cX(rooms[rooms.length-1]), y:cY(rooms[rooms.length-1]) } : null;
  const d = posLibre(rooms[1]);              doorPos = {x:d.x,y:d.y}; grid[d.y][d.x]=DOOR;

  // torches accrochées aux murs qui donnent sur un sol
  torches = [];
  for(let y=1;y<H-1;y++) for(let x=1;x<W-1;x++){
    if(grid[y][x]!==WALL || Math.random()>=0.09) continue;
    const c = [[1,0],[-1,0],[0,1],[0,-1]].filter(([dx,dy])=>grid[y+dy][x+dx]===FLOOR);
    if(c.length) { const [dx,dy]=c[(Math.random()*c.length)|0]; torches.push({x,y,dx,dy,ph:Math.random()*6}); }
  }

  // un thème par salle : le donjon cesse d'être des couloirs vides (façon D&D)
  const POOL = ['piliers','crypte','garde','reserve','sanctuaire'];
  for(let i=0;i<rooms.length;i++){
    rooms[i].theme = (i===0) ? null : POOL[(Math.random()*POOL.length)|0];  // l'entrée reste dégagée
  }
  const derniere = rooms[rooms.length-1];
  if(derniere) derniere.theme = bossSalle ? null : 'tresor';   // la dernière salle : la récompense

  ennemis = [];
  const nb = Math.min(14, 5 + niveau + (Math.random()*3|0));
  for(let i=0;i<nb;i++){
    const r = rooms[2 + (Math.random()*(rooms.length-2)|0)];
    const p = posLibre(r);
    const type = reglage.faune[(Math.random()*reglage.faune.length)|0];
    ennemis.push({ x:p.x+.5, y:p.y+.5, type,
                   vie:(type==='squelette'?2:type==='paysan'?3:1), cd:Math.random()*2,
                   ph:Math.random()*6, mort:0, obj:null,
                   phase:'garde', tempo:0 });
  }
}

/* ═══════════════ 2. MATIÈRES — tout est peint par le code ═══════════════ */
function bruit(ctx, w, h, force, taille){
  const d = ctx.getImageData(0,0,w,h), p = d.data;
  for(let i=0;i<p.length;i+=4){
    const n = (Math.random()-0.5)*force;
    p[i]+=n; p[i+1]+=n; p[i+2]+=n;
  }
  ctx.putImageData(d,0,0);
}

/* pierre appareillée : blocs décalés, joints creusés, salissures */
function texturePierre(){
  const S=512, c=document.createElement('canvas'); c.width=c.height=S;
  const g=c.getContext('2d');
  g.fillStyle='#3a3630'; g.fillRect(0,0,S,S);
  const bh=S/8;
  for(let r=0;r<8;r++){
    const dec=(r%2)*0.5, bw=S/4;
    for(let i=-1;i<5;i++){
      const x=(i+dec)*bw, y=r*bh;
      const t=48+Math.random()*26;
      g.fillStyle=`rgb(${t-6|0},${t-3|0},${t|0})`;
      g.fillRect(x+2.5,y+2.5,bw-5,bh-5);
      // usure : un coin plus clair, un bord plus sombre
      g.fillStyle=`rgba(220,232,240,${0.05+Math.random()*0.07})`;
      g.fillRect(x+2.5,y+2.5,bw-5,2.5);
      g.fillStyle='rgba(0,0,0,.28)';
      g.fillRect(x+2.5,y+bh-6,bw-5,3.5);
      // taches d'humidité
      if(Math.random()<0.35){
        g.fillStyle=`rgba(20,26,22,${0.1+Math.random()*0.22})`;
        g.beginPath();
        g.ellipse(x+bw*Math.random(), y+bh*Math.random(), bw*0.3, bh*0.4, 0, 0, 7);
        g.fill();
      }
    }
  }
  bruit(g,S,S,26);
  const t=new THREE.CanvasTexture(c);
  t.wrapS=t.wrapT=THREE.RepeatWrapping; t.colorSpace=THREE.SRGBColorSpace;
  t.anisotropy=4;
  return t;
}

/* relief : les joints en noir, les blocs en clair -> bumpMap */
function textureRelief(){
  const S=256, c=document.createElement('canvas'); c.width=c.height=S;
  const g=c.getContext('2d');
  g.fillStyle='#000'; g.fillRect(0,0,S,S);
  const bh=S/8;
  for(let r=0;r<8;r++){
    const dec=(r%2)*0.5, bw=S/4;
    for(let i=-1;i<5;i++){
      const x=(i+dec)*bw, y=r*bh;
      const v=190+Math.random()*50|0;
      g.fillStyle=`rgb(${v},${v},${v})`;
      g.fillRect(x+2,y+2,bw-4,bh-4);
    }
  }
  bruit(g,S,S,40);
  const t=new THREE.CanvasTexture(c);
  t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(1,1);
  return t;
}

/* dalles au sol, plus larges et plus usées */
function textureSol(){
  const S=512, c=document.createElement('canvas'); c.width=c.height=S;
  const g=c.getContext('2d');
  g.fillStyle='#26241f'; g.fillRect(0,0,S,S);
  for(let r=0;r<4;r++) for(let i=0;i<4;i++){
    const x=i*S/4, y=r*S/4, s=S/4, t=40+Math.random()*20;
    g.fillStyle=`rgb(${t},${t-2|0},${t-6|0})`;
    g.fillRect(x+3,y+3,s-6,s-6);
    g.fillStyle=`rgba(0,0,0,${0.06+Math.random()*0.14})`;
    g.beginPath(); g.ellipse(x+s/2,y+s/2,s*0.42,s*0.36,Math.random()*3,0,7); g.fill();
  }
  bruit(g,S,S,22);
  const t=new THREE.CanvasTexture(c);
  t.wrapS=t.wrapT=THREE.RepeatWrapping; t.colorSpace=THREE.SRGBColorSpace;
  t.anisotropy=4;
  return t;
}

/* tache lumineuse ronde, pour flammes / halos / poussière */
function textureHalo(dur=0.5){
  const S=128, c=document.createElement('canvas'); c.width=c.height=S;
  const g=c.getContext('2d');
  const d=g.createRadialGradient(S/2,S/2,0,S/2,S/2,S/2);
  d.addColorStop(0,'rgba(255,255,255,1)');
  d.addColorStop(dur,'rgba(255,255,255,.35)');
  d.addColorStop(1,'rgba(255,255,255,0)');
  g.fillStyle=d; g.fillRect(0,0,S,S);
  return new THREE.CanvasTexture(c);
}

/* toit : des rangées de tuiles qui se chevauchent, chacune sa nuance */
function textureTuiles(){
  const S=512, c=document.createElement('canvas'); c.width=c.height=S;
  const g=c.getContext('2d');
  g.fillStyle='#7a2a1e'; g.fillRect(0,0,S,S);
  const rh = S/10, rw = S/12;
  for(let r=0;r<11;r++){
    const dec = (r%2)*0.5;
    for(let i=-1;i<13;i++){
      const x=(i+dec)*rw, y=r*rh;
      const t = 150 + Math.random()*55;
      g.fillStyle = `rgb(${t|0},${t*0.42|0},${t*0.30|0})`;
      // une tuile : un rectangle au bord arrondi vers le bas
      g.beginPath();
      g.moveTo(x+1, y);
      g.lineTo(x+rw-1, y);
      g.lineTo(x+rw-1, y+rh*0.72);
      g.quadraticCurveTo(x+rw/2, y+rh*1.05, x+1, y+rh*0.72);
      g.closePath(); g.fill();
      g.strokeStyle='rgba(60,18,10,.55)'; g.lineWidth=2; g.stroke();
    }
  }
  bruit(g,S,S,16);
  const t=new THREE.CanvasTexture(c);
  t.wrapS=t.wrapT=THREE.RepeatWrapping; t.colorSpace=THREE.SRGBColorSpace;
  return t;
}

/* mur : un crépi crème, sali par le temps */
function textureCrepi(){
  const S=256, c=document.createElement('canvas'); c.width=c.height=S;
  const g=c.getContext('2d');
  g.fillStyle='#e6dcc2'; g.fillRect(0,0,S,S);
  for(let i=0;i<260;i++){
    g.fillStyle=`rgba(${190+Math.random()*40|0},${180+Math.random()*40|0},${155+Math.random()*40|0},.5)`;
    g.beginPath();
    g.ellipse(Math.random()*S, Math.random()*S, 3+Math.random()*14, 2+Math.random()*10, Math.random()*3, 0, 7);
    g.fill();
  }
  // traînées d'humidité en bas
  for(let i=0;i<14;i++){
    g.fillStyle=`rgba(120,120,95,${0.04+Math.random()*0.07})`;
    g.fillRect(Math.random()*S, S*0.6+Math.random()*S*0.4, 4+Math.random()*22, S*0.4);
  }
  bruit(g,S,S,14);
  const t=new THREE.CanvasTexture(c);
  t.wrapS=t.wrapT=THREE.RepeatWrapping; t.colorSpace=THREE.SRGBColorSpace;
  return t;
}

/* sol : des pavés irréguliers, pour le chemin */
function texturePaves(){
  const S=256, c=document.createElement('canvas'); c.width=c.height=S;
  const g=c.getContext('2d');
  g.fillStyle='#5d5449'; g.fillRect(0,0,S,S);
  for(let r=0;r<7;r++) for(let i=0;i<7;i++){
    const dec=(r%2)*0.5, w=S/7;
    const x=(i+dec)*w, y=r*w;
    const t=118+Math.random()*46;
    g.fillStyle=`rgb(${t|0},${t*0.95|0},${t*0.86|0})`;
    g.beginPath();
    g.ellipse(x+w/2, y+w/2, w*0.42, w*0.38, Math.random(), 0, 7);
    g.fill();
  }
  bruit(g,S,S,18);
  const t=new THREE.CanvasTexture(c);
  t.wrapS=t.wrapT=THREE.RepeatWrapping; t.colorSpace=THREE.SRGBColorSpace;

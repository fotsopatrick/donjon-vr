/* pose un panneau devant la tête, à `d` mètres, décalé de `bas` vers le bas */
const _v = new THREE.Vector3(), _q = new THREE.Quaternion();
function placerDevant(m, d, bas){
  camera.getWorldPosition(_v);
  camera.getWorldQuaternion(_q);
  const av = new THREE.Vector3(0,0,-1).applyQuaternion(_q);
  const ba = new THREE.Vector3(0,1,0).applyQuaternion(_q);
  m.position.copy(_v).addScaledVector(av, d).addScaledVector(ba, bas);
  m.quaternion.copy(_q);
}

/* ---- LA VOIX DU MONDE ----
   Elle n'appartient à personne. Elle constate, elle n'encourage pas. */
const OR = '255,214,130';

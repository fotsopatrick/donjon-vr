/* Le vrai personnage (Kenney, articulé, 32 animations) remplace l'ancien
   pantin de boîtes. Installé après le chargement des modèles. Un seul
   personnage animé, en 3e personne uniquement : coût négligeable. */
let mixerPerso = null, actionsPerso = {}, actionCourante = null;
const FRAPPE = { bras:1.5, avbras:0.7, buste:0.35, fente:0.16 };  // ampleur du geste (réglable via D.reglerFrappe)
function canonAnim(n){                 // ramène tout nom vers idle/walk/sprint/jump
  const s = (n||'').toLowerCase();
  if(s.includes('tpose') || s.includes('_pose') || s === 'pose') return null; // poses figées ignorées
  if(s.includes('sprint') || s.includes('run'))  return 'sprint';
  if(s.includes('walk'))                          return 'walk';
  if(s.includes('jump'))                          return 'jump';
  if(s.includes('idle') || s.includes('stand'))   return 'idle';
  return s;
}
// teinte le personnage : une tenue par joueur (Patrick = noir/ninja), + tête ton peau
const TENUES = {
  Patrick: { corps:0x33357e, tete:0x6b4a34, accent:0xd8b45a },  // MAGE : robe indigo, peau, or
  Hamda:   { corps:0x2a2036, tete:0x7a5a44, accent:0x6a3a5a },  // violet sombre
};
function teinterPerso(perso, nom){
  const T = TENUES[nom] || TENUES.Patrick;
  perso.traverse(o=>{
    if(!o.isMesh || !o.material) return;
    o.material = o.material.clone();
    const n = (o.name||'').toLowerCase();
    let col = T.corps;
    if(/visor|head|face|tete/.test(n)) col = T.tete;      // la tête -> ton peau (visage)
    else if(/eye|oeil/.test(n))        col = 0xffffff;
    if(o.material.color)    o.material.color.setHex(col);
    if(o.material.emissive) o.material.emissive.setHex(0x000000);
    if('metalness' in o.material) o.material.metalness = 0.1;
    if('roughness' in o.material) o.material.roughness = 0.85;
  });
}
function installerAvatar(){
  // (re)construit l'avatar du joueur courant ; nettoie le précédent (changement de joueur)
  if(avatar.userData && avatar.userData.perso){ avatar.remove(avatar.userData.perso); }
  mixerPerso = null; actionsPerso = {}; actionCourante = null;
  // priorité : ton fichier perso-custom > le modèle du joueur (persoHamda/persoPatrick) > le défaut
  const cleJoueur = 'perso' + (typeof joueurNom !== 'undefined' ? joueurNom : 'Patrick');
  const perso = MODELES.persoCustom || MODELES[cleJoueur] || MODELES.perso;
  const anims = (perso && perso.userData && perso.userData.anims && perso.userData.anims.length)
                ? perso.userData.anims
                : (MODELES.persoCustom ? ANIM_PERSO_CUSTOM : ANIM_PERSO);
  if(!perso) return;
  const bb = new THREE.Box3().setFromObject(perso);
  const h = bb.getSize(new THREE.Vector3()).y || 1;
  perso.scale.setScalar(1.7 / h);
  perso.position.set(0, 0, 0);
  let estMixamo = false;
  perso.traverse(o=>{ if(/mixamorig/i.test(o.name)) estMixamo = true; });
  perso.rotation.y = estMixamo ? Math.PI : 0;   // Mixamo regarde +Z (demi-tour) ; Quaternius regarde déjà -Z
  avatar.userData.persoFace = perso;
  perso.traverse(o=>{ if(o.isMesh){ o.castShadow = true; o.frustumCulled = false; } });
  avatar.add(perso);
  avatar.userData = { perso };
  if(anims.length){
    mixerPerso = new THREE.AnimationMixer(perso);
    // mapping EXACT (Quaternius) prioritaire, puis repli canonAnim (Soldier & co.)
    const EXACT = { Idle_Loop:'idle', Walk_Loop:'walk', Sprint_Loop:'sprint', Jog_Fwd_Loop:'walk',
                    Jump_Loop:'jump', Jump_Start:'jump', Sword_Attack:'attaque', Death01:'mort',
                    Idle_A:'idle', Walking_A:'walk', Walking_B:'walk', Running_A:'sprint', Running_B:'sprint',
                    Jump_Idle:'jump', Throw:'attaque', Use_Item:'attaque', Hit_A:'hit', Death_A:'mort' };
    for(const clip of anims){ const k = EXACT[clip.name]; if(k && !actionsPerso[k]) actionsPerso[k] = mixerPerso.clipAction(clip); }
    for(const clip of anims){ const k = canonAnim(clip.name); if(k && !actionsPerso[k]) actionsPerso[k] = mixerPerso.clipAction(clip); }
    // enchaînement varié façon Naruto (taijutsu) : jab -> cross -> coupe -> coupe
    const parNom = {}; for(const clip of anims) parNom[clip.name] = clip;
    const COMBO = ['Punch_Jab','Punch_Cross','Sword_Attack','Sword_Attack'];
    actionsPerso.attaques = COMBO.map(n => parNom[n] ? mixerPerso.clipAction(parNom[n]) : actionsPerso.attaque);
    jouerAnim('idle');
  }

  // --- l'épée dans la main droite (os Mixamo « RightHand ») ---
  let mainDroite = null;
  perso.traverse(o=>{ if(!mainDroite && (/RightHand$/i.test(o.name) || /^hand_r$/i.test(o.name) || /hand_R$/.test(o.name))) mainDroite = o; });
  if(mainDroite){
    perso.updateWorldMatrix(true, true);
    const s = new THREE.Vector3(); mainDroite.getWorldScale(s);
    const epee = arme.clone(true);
    epee.visible = true;
    // taille réelle constante quel que soit le squelette : on annule l'échelle de l'os
    const echelleEpee = 0.5 / (s.x || 1);
    epee.scale.setScalar(echelleEpee);
    epee.position.set(0, 0.03/(s.x||1), 0.03/(s.x||1));
    epee.rotation.set(-0.4, 0, Math.PI*0.5);   // grip : lame vers l'avant (ajustable via D.reglerEpee)
    epee.userData.baseScale = echelleEpee;
    epee.userData.base = { x:epee.rotation.x, y:epee.rotation.y, z:epee.rotation.z };
    mainDroite.add(epee);
    avatar.userData.epeeMain = epee;
  }
  // les os pour un vrai geste de frappe (épaule, avant-bras, buste)
  perso.traverse(o=>{
    if(/RightArm$/i.test(o.name))          avatar.userData.brasD   = o;
    else if(/RightForeArm$/i.test(o.name)) avatar.userData.avBrasD = o;
    else if(/Spine2$/i.test(o.name))       avatar.userData.buste   = o;
  });
}
function jouerAnim(nom){
  const a = actionsPerso[nom] || actionsPerso.idle || Object.values(actionsPerso)[0];
  if(!a || a === actionCourante) return;
  if(actionCourante) actionCourante.fadeOut(0.15);
  a.reset().fadeIn(0.15).play();
  actionCourante = a;
}
function jouerAttaque(){
  const a = (actionsPerso.attaques && actionsPerso.attaques[joueur.combo % actionsPerso.attaques.length]) || actionsPerso.attaque;
  if(!a) return false;
  // caler la vitesse du swing sur le rythme du combo : il finit son arc, fluide
  const fenetre = ([0.40,0.30,0.44,0.62][joueur.combo] || 0.40) * 1.1;
  const clip = a.getClip ? a.getClip() : a._clip;
  const duree = (clip && clip.duration) ? clip.duration : 0.8;
  a.timeScale = Math.min(2.4, Math.max(0.9, duree / fenetre));
  a.reset(); a.setLoop(THREE.LoopOnce, 1); a.clampWhenFinished = true;
  if(actionCourante && actionCourante !== a) actionCourante.fadeOut(0.08);
  a.fadeIn(0.06).play();
  actionCourante = a;
  joueur.animAtk = 0.45;             // fenêtre où l'attaque prime sur la marche
  return true;
}

/* la vue : 1 = à la première personne, 3 = derrière l'épaule */
let vue = 1, reculCam = 0;

function basculerVue(){
  vue = (vue === 1) ? 3 : 1;
  avatar.visible  = (vue === 3);
  arme.visible    = (vue === 1);
  armeDos.visible = false;
  dire(vue === 3 ? 'Vue extérieure.' : 'Vue à la première personne.', 1.8);
}

/* ═══════════════ 4 quater. BÂTIR LE HAMEAU ═══════════════ */

function poserMontagnes(){
  // Anneau de montagnes lointaines, fondu en UN mesh (~1 draw call).
  // Couleur proche de la brume : elles se fondent à l'horizon = silhouette Skyrim.
  const cx = W*T/2, cz = H*T/2;
  const geos = [];
  const N = 16;
  for(let i=0;i<N;i++){
    const a = (i/N)*Math.PI*2 + (i%3)*0.11;
    const d = 108 + (i%4)*12;                 // au-delà du village, sous le dôme (r=160)
    const haut = 26 + (i*7 % 34);             // crêtes inégales
    const large = 22 + (i*5 % 20);
    const g = new THREE.ConeGeometry(large, haut, 5 + (i%3), 1).toNonIndexed();
    g.rotateY((i*1.7) % 6.28);                // casser la régularité des faces
    g.translate(cx + Math.cos(a)*d, haut/2 - 4, cz + Math.sin(a)*d);
    geos.push(g);
  }
  const geo = mergeGeometries(geos, false);
  const mat = new THREE.MeshLambertMaterial({ color:0x8d99a6, fog:true }); // gris-bleu, avalé par la brume
  const m = new THREE.Mesh(geo, mat);
  m.matrixAutoUpdate = false; m.updateMatrix();
  monde.add(m);
}
function batirDehors(){
  hemi.color.setHex(0x5b6ba8); hemi.groundColor.setHex(0x171d30); hemi.intensity = 1.05;   // village : clair de lune
  while(monde.children.length){
    const o = monde.children.pop();
    o.traverse?.(n=>{ n.geometry?.dispose?.(); });
    monde.remove(o);
  }
  flammes=[]; meshEnnemis=[]; coffre=null; pieges=[]; jumeaux=[];
  decors=[]; objets=[]; murIM=null; villageois=[];
  if(boss){ scene.remove(boss.jauge.mesh); boss = null; }
  ondes = []; tranches = []; projectiles = [];

  /* --- le ciel : la photo si on l'a, sinon le dôme peint --- */
  if(cielReel){
    scene.background = new THREE.Color(0x0a1230);
  } else {
  const ciel = new THREE.Mesh(
    new THREE.SphereGeometry(160, 24, 16),
    new THREE.ShaderMaterial({
      side: THREE.BackSide, depthWrite: false, fog: false,
      uniforms: {
        haut:  { value: new THREE.Color(0x3f8fe0) },
        bas:   { value: new THREE.Color(0xdcefff) },
      },
      vertexShader: `
        varying float h;
        void main(){
          vec4 p = modelMatrix * vec4(position, 1.0);
          h = normalize(p.xyz).y;
          gl_Position = projectionMatrix * viewMatrix * p;
        }`,
      fragmentShader: `
        uniform vec3 haut; uniform vec3 bas;
        varying float h;
        void main(){
          // trois paliers, comme le reste : un ciel dessiné, pas photographié
          float k = clamp(h * 1.4 + 0.25, 0.0, 1.0);
          k = floor(k * 4.0) / 4.0;
          gl_FragColor = vec4(mix(bas, haut, k), 1.0);
        }`,
    }));
  ciel.position.set(W*T/2, 0, H*T/2);
  monde.add(ciel);
  }

  poserMontagnes();

  const soleil = new THREE.Mesh(
    new THREE.CircleGeometry(7, 24),
    new THREE.MeshBasicMaterial({ color:0xfff4c8, fog:false }));
  soleil.position.set(W*T/2 - 70, 55, H*T/2 - 95);
  soleil.lookAt(W*T/2, 12, H*T/2);
  if(!cielReel) monde.add(soleil);

  /* --- des nuages peints, seulement si l'on n'a pas la photo --- */
  if(!cielReel){
    const geo = new THREE.IcosahedronGeometry(1, 1);
    const mat = new THREE.MeshToonMaterial({ color:0xffffff, gradientMap:NUANCIER, fog:false });
    for(let i=0;i<6;i++){
      const g = new THREE.Group();
      const n = 3 + (Math.random()*2|0);
      for(let j=0;j<n;j++){
        const b = new THREE.Mesh(geo, mat);
        b.position.set((Math.random()-0.5)*14, (Math.random()-0.5)*3, (Math.random()-0.5)*8);
        b.scale.setScalar(3 + Math.random()*4.5);
        g.add(b);
      }
      const a = Math.random()*6.28, d = 80 + Math.random()*60;
      g.position.set(W*T/2 + Math.cos(a)*d, 38 + Math.random()*18, H*T/2 + Math.sin(a)*d);
      monde.add(g);
    }
  }

  /* --- la prairie --- */
  const herbe = new THREE.Mesh(
    new THREE.PlaneGeometry(W*T, H*T),
    new THREE.MeshStandardMaterial({ color:0x54585f, roughness:0.95 }));  // sol gris ville
  herbe.rotation.x = -Math.PI/2;
  herbe.position.set(W*T/2, 0, H*T/2);
  herbe.receiveShadow = true;
  monde.add(herbe);

  // des touffes, semées en une seule fournée
  {
    const geo = new THREE.ConeGeometry(0.07, 0.3, 3);
    const mat = new THREE.MeshToonMaterial({ color:0x585c64, gradientMap:NUANCIER });  // sol gris ville
    const N = 0;
    const touffes = new THREE.InstancedMesh(geo, mat, N);
    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler();
    const p = new THREE.Vector3(), sc = new THREE.Vector3();
    let n = 0;
    for(let i=0;i<N*3 && n<N;i++){
      const x = Math.random()*W*T, z = Math.random()*H*T;
      if(mur(x, z)) continue;
      e.set(0, Math.random()*6, (Math.random()-0.5)*0.35);
      q.setFromEuler(e);
      p.set(x, 0.2, z);
      sc.set(1, 0.7 + Math.random()*0.8, 1);
      m4.compose(p, q, sc);
      touffes.setMatrixAt(n++, m4);
    }
    touffes.count = n;
    touffes.instanceMatrix.needsUpdate = true;
    monde.add(touffes);
  }

  /* --- la palissade tout autour --- */
  {
    const bois = mat('bois', 0.5, 2, 0x9a7c56);
    const pieu = new THREE.CylinderGeometry(0.14, 0.16, 1.7, 6);
    const pieux = [];
    for(let x=0;x<W;x++){ pieux.push([x, 0]); pieux.push([x, H-1]); }
    for(let y=1;y<H-1;y++){ pieux.push([0, y]); pieux.push([W-1, y]); }
    const im = new THREE.InstancedMesh(pieu, bois, pieux.length*2);
    const m4 = new THREE.Matrix4();
    let n = 0;
    for(const [gx, gy] of pieux){
      for(const d of [-0.55, 0.55]){
        m4.makeTranslation(gx*T + T/2 + d*(gy===0||gy===H-1?1:0),
                           0.85 + Math.random()*0.12,
                           gy*T + T/2 + d*(gx===0||gx===W-1?1:0));
        im.setMatrixAt(n++, m4);
      }
    }
    im.count = n; im.instanceMatrix.needsUpdate = true;
    monde.add(im);
  }

  /* --- les deux maisons, à colombages --- */
  for(const m of MAISONS){
    const g = new THREE.Group();
    const lx = m.w*T*0.82, lz = m.h*T*0.82;
    const hh = m.etage ? 6.2 : 4.4;                 // certaines ont un étage de plus
    const couverture = m.chaume ? 'toit-chaume' : 'toit-tuiles';

    const mur_ = new THREE.Mesh(new THREE.BoxGeometry(lx, hh, lz),
      mat('mur-crepi', 2.4, 1.6, 0xf0e6d0));
    mur_.position.y = hh/2;

    // le toit, en tuiles, avec un vrai débord
    const toit = new THREE.Mesh(new THREE.CylinderGeometry(lz*0.34, lz*0.34, lx*1.14, 3, 1, false),
      mat(couverture, 3, 2, m.chaume ? 0xc8a86a : 0xffffff));
    toit.rotation.set(0, 0, Math.PI/2);
    toit.rotation.y = Math.PI/2;
    toit.position.y = hh + lz*0.14;

    // un second corps de bâtiment, plus bas : la silhouette cesse d'être une boîte
    // un étage en surplomb : la façade cesse d'être un plan, sans croiser le toit
    const encorbellement = new THREE.Mesh(
      new THREE.BoxGeometry(lx*1.12, hh*0.34, lz*1.12),
      mat('mur-crepi', 2.6, 0.7, 0xe8dcc4));
    encorbellement.position.y = hh*0.72;
    g.add(encorbellement);

    /* --- LES COLOMBAGES ---
       C'est ça qui fait la maison allemande : un cadre de poutres, des croix
       de Saint-André entre les montants, et des V sous la toiture. */
    const poutre = mat('bois', 1, 1, 0x8a7050);
    function barre(lon, ep=0.16){ return new THREE.Mesh(new THREE.BoxGeometry(lon, ep, ep), poutre); }

    for(const [face, larg, prof] of [['z', lx, lz/2+0.02], ['z-', lx, -lz/2-0.02],
                                     ['x', lz, lx/2+0.02], ['x-', lz, -lx/2-0.02]]){
      const horizontal = face.startsWith('z');
      const pose = (b, u, y, rot=0)=>{
        if(horizontal){ b.position.set(u, y, prof); b.rotation.z = rot; }
        else          { b.position.set(prof, y, u); b.rotation.set(0, Math.PI/2, rot); }
        g.add(b);
      };
      // sablières haute et basse
      for(const y of [0.14, hh*0.52, hh-0.14]) pose(barre(larg), 0, y);
      // poteaux verticaux
      const N = 4;
      for(let i=0;i<=N;i++){
        const u = -larg/2 + i*(larg/N);
        const p = barre(hh); pose(p, u, hh/2, Math.PI/2);
      }
      // croix de Saint-André dans deux travées sur trois
      for(let i=0;i<N;i++){
        if(i % 3 === 2) continue;
        const u = -larg/2 + (i+0.5)*(larg/N);
        const l = Math.hypot(larg/N, hh*0.52);
        for(const sens of [1, -1]){
          const d = barre(l*0.96, 0.13);
          pose(d, u, hh*0.26, sens*Math.atan2(hh*0.52, larg/N));
        }
      }
    }

    // la porte et deux fenêtres, sur la face qui regarde le centre
    const versCentre = (m.x < W/2) ? 1 : -1;
    const porte_ = new THREE.Mesh(new THREE.BoxGeometry(1.05, 1.95, 0.16),
      mat('bois', 1, 1.6, 0x6b5030));
    porte_.position.set(0, 0.98, versCentre*(lz/2 + 0.05));
    const poignee = new THREE.Mesh(new THREE.SphereGeometry(0.07, 8, 8),
      new THREE.MeshToonMaterial({ color:0xd8b45a, gradientMap:NUANCIER }));
    poignee.position.set(0.36, 1.0, versCentre*(lz/2 + 0.14));
    g.add(porte_, poignee);

    const boisF = mat('bois', 0.6, 0.6, 0x6b5030);
    const rangees = m.etage ? [2.2, 4.6] : [2.2];
    for(const fy of rangees){
      for(const fx of [-lx*0.28, lx*0.28]){
        const cadre = new THREE.Mesh(new THREE.BoxGeometry(0.95, 0.95, 0.14), boisF);
        cadre.position.set(fx, fy, versCentre*(lz/2 + 0.04));
        const vitre = new THREE.Mesh(new THREE.BoxGeometry(0.72, 0.72, 0.1),
          new THREE.MeshBasicMaterial({ color:0xffd07a }));
        vitre.position.set(fx, fy, versCentre*(lz/2 + 0.11));
        g.add(cadre, vitre);
        // les volets, de part et d'autre
        for(const c of [-1, 1]){
          const v = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.9, 0.07), boisF);
          v.position.set(fx + c*0.63, fy, versCentre*(lz/2 + 0.12));
          v.rotation.y = c*0.35*versCentre;
          g.add(v);
        }
      }
    }

    // la cheminée, en pierre irrégulière
    const chem = new THREE.Mesh(new THREE.BoxGeometry(0.66, 1.7, 0.66),
      mat('mur-pierre', 1.2, 2.4));
    chem.position.set(lx*0.28, hh + 1.0, -lz*0.2);
    const couronne = new THREE.Mesh(new THREE.BoxGeometry(0.82, 0.16, 0.82),
      mat('mur-pierre', 1, 0.3, 0xa09480));
    couronne.position.set(lx*0.28, hh + 1.9, -lz*0.2);
    g.add(chem, couronne);

    // du lierre qui grimpe sur un pignon
    const feuille = new THREE.IcosahedronGeometry(0.17, 0);
    const vert = new THREE.MeshToonMaterial({ color:0x50682f, gradientMap:NUANCIER });
    for(let i=0;i<12;i++){
      const f = new THREE.Mesh(feuille, vert);
      const h2 = Math.random()*hh*0.95;
      f.position.set(-lx/2 - 0.06,
                     0.15 + h2,
                     (Math.random()-0.5)*lz*0.9);
      f.scale.setScalar(0.6 + Math.random()*0.8);
      f.rotation.set(Math.random()*3, Math.random()*3, Math.random()*3);
      g.add(f);
    }

    g.add(mur_, toit);
    g.position.set((m.x + m.w/2)*T, 0, (m.y + m.h/2)*T);
    fondre(g);                      // quarante morceaux → quatre blocs
    monde.add(g);

    for(let i=0;i<7;i++){
      const f = new THREE.Sprite(new THREE.SpriteMaterial({
        map:texHalo, color:0xf0f0f0, transparent:true, opacity:0.32, depthWrite:false }));
      f.position.set(g.position.x + lx*0.28, hh + 2.2 + i*0.75, g.position.z - lz*0.2);
      f.scale.setScalar(0.7 + i*0.28);
      monde.add(f);
      flammes.push({ sp:f, ph:i*0.9, x:f.position.x, z:f.position.z, fumee:true, base:hh+2.2+i*0.75 });
    }
  }

  /* --- les fanions, tendus au-dessus de la place --- */
  {
    const a = MAISONS[0], b = MAISONS[1];
    const ax = (a.x + a.w/2)*T, az = (a.y + a.h/2)*T;
    const bx = (b.x + b.w/2)*T, bz = (b.y + b.h/2)*T;
    const couleurs = [0xe05a4a, 0xf0c04a, 0x4aa8e0, 0x6ec45a, 0xd07ad0];
    const guirlande = new THREE.Group();
    const N = 22;
    for(let i=1;i<N;i++){
      const k = i/N;
      const x = ax + (bx-ax)*k, z = az + (bz-az)*k;
      const y = 4.6 - Math.sin(k*Math.PI)*1.5;      // la corde pend
      const f = new THREE.Mesh(new THREE.ConeGeometry(0.16, 0.34, 3),
        new THREE.MeshLambertMaterial({ color:couleurs[i%couleurs.length],
          side:THREE.DoubleSide }));
      f.position.set(x, y - 0.2, z);
      f.rotation.x = Math.PI;
      guirlande.add(f);
    }
    monde.add(guirlande);
  }

  /* --- les rues pavées, et la place au croisement --- */
  {
    const rues = new THREE.Group();
    const matRue = mat('paves', 1, 1);
    for(const r of RUES){
      const larg = r.w*T, prof = r.h*T;
      const g = new THREE.Mesh(new THREE.PlaneGeometry(larg, prof), matRue);

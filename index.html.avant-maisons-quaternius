/* Un vrai projectile élémentaire lancé vers l'avant : feu, eau, ou lame de vent. */
function lancerProjectile(type){
  const CONF = {
    feu:  { col:0xff6a1e, lum:0xff3000, r:0.30, v:11, degat:3, lame:false },
    eau:  { col:0x4aa8ff, lum:0x1060e0, r:0.32, v:10, degat:2, lame:false },
    vent: { col:0xcafff0, lum:0x40e0a0, r:0.5,  v:15, degat:2, lame:true  },
  };
  const c = CONF[type] || CONF.feu;
  const dir = new THREE.Vector3(); camera.getWorldDirection(dir);
  const n = Math.hypot(dir.x, dir.z) || 1, dx = dir.x/n, dz = dir.z/n;
  let mesh;
  if(c.lame){
    mesh = new THREE.Mesh(new THREE.TorusGeometry(0.45, 0.07, 6, 18, Math.PI*1.15),
      new THREE.MeshBasicMaterial({ color:c.col, transparent:true, opacity:0.9, blending:THREE.AdditiveBlending, depthWrite:false }));
    mesh.rotation.y = Math.atan2(dx, dz); mesh.rotation.z = Math.PI/2;
  } else {
    mesh = new THREE.Mesh(new THREE.SphereGeometry(c.r, 12, 10),
      new THREE.MeshBasicMaterial({ color:c.col, transparent:true, opacity:0.96, blending:THREE.AdditiveBlending, depthWrite:false }));
  }
  const lum = new THREE.PointLight(c.lum, 9, 6, 2); mesh.add(lum);
  mesh.position.set(joueur.x + dx*0.9, 1.15, joueur.z + dz*0.9);
  monde.add(mesh);
  projectiles.push({ obj:mesh, dx, dz, v:c.v, degat:c.degat, vie:2.2, type });
  window.Sons?.coup(); joueur.secousse = Math.max(joueur.secousse, 0.22);
}
function majProjectiles(dt){
  for(let i=projectiles.length-1;i>=0;i--){
    const p = projectiles[i];
    p.vie -= dt;
    p.obj.position.x += p.dx * p.v * dt;
    p.obj.position.z += p.dz * p.v * dt;
    p.obj.rotation.y += dt*6;
    const px = p.obj.position.x, pz = p.obj.position.z;
    let fini = p.vie <= 0 || mur(px, pz);
    // ennemis
    for(const e of (ennemis||[])){
      if(e.vie<=0) continue;
      if(Math.hypot(e.x*T-px, e.y*T-pz) < 1.1){ e.vie -= p.degat; if(e.vie<=0){ e.vie=0; e.mort=0.55; } window.Sons?.impact(); fini = true; break; }
    }
    // le boss
    if(!fini && boss && boss.mort<=0 && Math.hypot(boss.x-px, boss.z-pz) < 2.2){ frapperBoss(p.degat); fini = true; }
    // le guerrier
    if(!fini && guerrier && guerrier.vie>0 && Math.hypot(guerrier.x-px, guerrier.z-pz) < 1.6){
      guerrier.vie -= p.degat; guerrier.jouer('hit'); window.Sons?.impact();
      if(guerrier.vie<=0){ guerrier.vie=0; guerrier.jouer('mort'); guerrier.mortT=1.8; dire('Guerrier vaincu !',3); }
      fini = true;
    }
    if(fini){ monde.remove(p.obj); projectiles.splice(i,1); }
  }
}

/* les rejetons : de vrais petits slimes, ils rejoignent les habitants */
function cracherRejetons(n){
  for(let i=0;i<n;i++){
    const a = Math.random()*6.28, d = 1.8 + Math.random();
    const x = boss.x + Math.cos(a)*d, z = boss.z + Math.sin(a)*d;
    if(mur(x, z)) continue;
    const g = new THREE.Group();
    const corps = new THREE.Mesh(
      new THREE.IcosahedronGeometry(0.34, 3),
      new THREE.MeshStandardMaterial({ color:0x2fa8d8, emissive:0x0d5f88,
        emissiveIntensity:0.55, transparent:true, opacity:0.78, roughness:0.12 }));
    const oG = new THREE.Mesh(new THREE.SphereGeometry(0.06,8,8),
      new THREE.MeshBasicMaterial({color:0x05070a}));
    oG.position.set(-0.13,0.08,0.29);
    const oD = oG.clone(); oD.position.x = 0.13;
    g.add(corps, oG, oD);
    g.position.set(x, 0.34, z);
    styliser(g, 0.016);
    monde.add(g);
    const e = { x:x/T, y:z/T, type:'slime', vie:1, cd:0, ph:Math.random()*6,
                mort:0, obj:g };
    e.obj.userData.corps = corps;
    ennemis.push(e);
  }
  bip(300, 0.14, 'square', 0.05);
}

/* on lui tape dessus */
function frapperBoss(degats){
  boss.vie -= degats;
  boss.touche = 0.22;
  dessinerJauge();
  bip(260, 0.1, 'square', 0.08); bip(130, 0.24, 'sawtooth', 0.07, 0.05);
  if(!boss.enrage && boss.vie <= boss.vieMax/2){
    boss.enrage = true;
    boss.corps.material.color.setHex(0x8c2418);
    boss.corps.material.emissive.setHex(0x5a1008);
    boss.noyau.material.color.setHex(0xff7a5a);
    boss.lueur.color.setHex(0xff6a48);
    dessinerJauge();
    voixDuMonde('Le gardien change. Il ne joue plus.');
  }
  if(boss.vie <= 0) tuerBoss();
}

function tuerBoss(){
  boss.mort = 1.6;
  boss.lueur.intensity = 0;
  joueur.secousse = 0.9;
  boss.jauge.mesh.visible = false;
  bip(200,0.3,'sawtooth',0.1); bip(120,0.55,'sawtooth',0.1,0.2);
  // la clé qu'il gardait tombe là où il meurt
  cleVerrouillee = false;
  if(meshCle){
    meshCle.position.set(boss.x, 1.15, boss.z);
    meshCle.visible = true;
  }
  const pouvoir = ['DÉVOREUR','CARAPACE','APPEL','SOUFFLE','REGARD'][ (niveau/PALIER - 1) % 5 ];
  // DÉVOREUR n'est pas un effet : c'est un mot que l'esprit comprendra désormais
  if(!debloquer(pouvoir))
    voixDuMonde('Le gardien est tombé. La clé est à toi.');
  // debloquer() annonce déjà lui-même quand le pouvoir est neuf
  if(!pouvoirsPerso[pouvoir]) {
    // ce qu'il fait, en clair : le pouvoir gagné est une phrase que tu prononces
    pouvoirsPerso[pouvoir] = ({
      'DÉVOREUR':'crée une potion', 'CARAPACE':'un bouclier', 'APPEL':'je me duplique',
      'SOUFFLE':'brise les murs', 'REGARD':'une torche',
    })[pouvoir];
    sauverPouvoirs();
  }
}

/* le cerveau du gardien, appelé à chaque image */
function majBoss(dt, t){
  if(!boss) return;

  if(boss.mort > 0){
    boss.mort -= dt;
    const k = Math.max(0, boss.mort/1.6);
    boss.obj.scale.set(1 + (1-k)*0.5, k*k, 1 + (1-k)*0.5);   // il s'affaisse et s'étale
    boss.corps.material.opacity = 0.82*k;
    boss.noyau.material.opacity = 0.9*k;
    if(boss.mort <= 0){ monde.remove(boss.obj); scene.remove(boss.jauge.mesh); boss = null; }
    return;
  }

  const dx = joueur.x - boss.x, dz = joueur.z - boss.z;
  const dist = Math.hypot(dx, dz);

  // il dort tant qu'on ne l'approche pas
  if(boss.etat === 'dort'){
    if(dist < 9){
      boss.etat = 'attend'; boss.cd = 1.2;
      voixDuMonde('Le gardien du palier s\'éveille.');
    }
  } else {
    boss.cd -= dt;
    const vite = boss.enrage ? 1.7 : 1.0;

    if(boss.etat === 'attend'){
      // il tourne autour, il se rapproche lentement
      const n = dist || 1;
      const v = 1.15 * vite * dt;
      const nx = boss.x + dx/n*v, nz = boss.z + dz/n*v;
      if(!mur(nx, boss.z)) boss.x = nx;
      if(!mur(boss.x, nz)) boss.z = nz;
      if(boss.cd <= 0){
        // il choisit : charge, coup au sol, ou rejetons
        const r = Math.random();
        if(dist > 4.5 || r < 0.4){
          boss.etat = 'charge'; boss.charge = 0.9;
          boss.cx = dx/(dist||1); boss.cz = dz/(dist||1);
          bip(180, 0.3, 'sawtooth', 0.07);
        } else if(r < 0.75){
          boss.etat = 'saut'; boss.charge = 0.55;
        } else {
          cracherRejetons(boss.enrage ? 3 : 2);
          boss.cd = (boss.enrage ? 1.6 : 2.6);
        }
      }
    }
    else if(boss.etat === 'charge'){
      boss.charge -= dt;
      const v = 8.5 * vite * dt;
      const nx = boss.x + boss.cx*v, nz = boss.z + boss.cz*v;
      let cogne = false;
      if(!mur(nx, boss.z)) boss.x = nx; else cogne = true;
      if(!mur(boss.x, nz)) boss.z = nz; else cogne = true;
      if(cogne){                       // il s'écrase sur la pierre : ça t'arrange
        lancerOnde(boss.x, boss.z);
        boss.etat = 'attend'; boss.cd = 1.5; boss.charge = 0;
      }
      if(boss.charge <= 0){ boss.etat = 'attend'; boss.cd = (boss.enrage?0.9:1.8); }
      if(dist < 1.9) blesser(joueur.x - boss.x, joueur.z - boss.z);
    }
    else if(boss.etat === 'saut'){
      boss.charge -= dt;
      if(boss.charge <= 0){
        lancerOnde(boss.x, boss.z);
        boss.etat = 'attend'; boss.cd = (boss.enrage?1.1:2.0);
      }
    }
  }

  // la masse respire, et sursaute quand on la touche
  const resp = 1 + Math.sin(t*(boss.enrage?5.2:2.6))*0.09;
  const sur  = boss.touche > 0 ? 1 + boss.touche*0.9 : 1;
  if(boss.touche > 0) boss.touche -= dt;
  const ecrase = boss.etat === 'saut' ? 1 - (0.55 - boss.charge) : 1;
  boss.obj.scale.set(sur/Math.sqrt(resp), resp*ecrase*sur, sur/Math.sqrt(resp));
  boss.obj.position.set(boss.x, boss.etat==='charge' ? 0.1 : 0, boss.z);
  boss.obj.rotation.y = Math.atan2(dx, dz);
  boss.noyau.scale.setScalar(1 + Math.sin(t*(boss.enrage?9:4.5))*0.16);
  boss.lueur.intensity = (boss.enrage ? 22 : 14) + Math.sin(t*7)*3;

  // la jauge flotte au-dessus de lui et te regarde
  const j = boss.jauge.mesh;
  j.position.set(boss.x, 4.3, boss.z);
  camera.getWorldPosition(_v);
  j.lookAt(_v);
}

/* La lame d'air : un croissant qui part devant toi et fauche ce qu'il traverse. */
function lancerTranche(){
  const g = new THREE.Mesh(
    new THREE.TorusGeometry(0.9, 0.07, 6, 20, Math.PI*0.8),
    new THREE.MeshBasicMaterial({ color:0xcfe8ff, transparent:true, opacity:0.9,
      blending:THREE.AdditiveBlending, depthWrite:false, side:THREE.DoubleSide }));
  g.position.set(joueur.x, 1.1, joueur.z);
  g.rotation.set(Math.PI/2, 0, joueur.lacet);
  monde.add(g);
  tranches.push({ obj:g, d:0,
    dx:-Math.sin(joueur.lacet), dz:-Math.cos(joueur.lacet),
    x:joueur.x, z:joueur.z, touches:new Set() });
}
let tranches = [];

function majTranches(dt){
  for(let i=tranches.length-1;i>=0;i--){
    const tr = tranches[i];
    tr.d += dt*13;
    const x = tr.x + tr.dx*tr.d, z = tr.z + tr.dz*tr.d;
    tr.obj.position.set(x, 1.1, z);
    tr.obj.material.opacity = Math.max(0, 0.9 - tr.d/8);
    tr.obj.scale.setScalar(1 + tr.d*0.06);
    for(const e of ennemis){
      if(e.vie<=0 || tr.touches.has(e)) continue;
      if(Math.hypot(e.x*T-x, e.y*T-z) < 1.2){
        tr.touches.add(e);
        e.vie -= 3;
        if(e.vie<=0){ e.vie=0; e.mort=0.55; }
        bip(200,0.14,'sawtooth',0.06);
      }
    }
    if(boss && boss.mort<=0 && !tr.touches.has(boss) && Math.hypot(boss.x-x, boss.z-z) < 2.2){
      tr.touches.add(boss); frapperBoss(2);
    }
    if(tr.d > 9 || mur(x, z)){ monde.remove(tr.obj); tranches.splice(i,1); }
  }
}

/* les ondes courent au sol jusqu'à s'éteindre */
function majOndes(dt){
  for(let i=ondes.length-1;i>=0;i--){
    const o = ondes[i];
    o.r += dt*7.5;
    o.obj.scale.setScalar(o.r);
    o.obj.material.opacity = Math.max(0, 0.85 - o.r/9);
    const d = Math.hypot(joueur.x-o.x, joueur.z-o.z);
    if(!o.touche && Math.abs(d - o.r*0.6) < 0.6){ o.touche = true; blesser(joueur.x-o.x, joueur.z-o.z); }
    if(o.r > 14){ monde.remove(o.obj); ondes.splice(i,1); }
  }
  majProjectiles(dt);
}

/* Trois crans de qualité. On commence au plus beau ; la touche P descend
   d'un cran. Chaque cran retire ce qui coûte le plus pour ce qu'il rend. */
let cranQualite = 0;
const CRANS = ['tout', 'sans ombres', 'sobre'];
function baisserQualite(){
  cranQualite = (cranQualite + 1) % 3;
  if(cranQualite === 0){
    renderer.shadowMap.enabled = true;
    renderer.setPixelRatio(1);
    scene.traverse(o=>{ if(o.isPoints) o.visible = true; });
  } else if(cranQualite === 1){
    renderer.shadowMap.enabled = false;      // les ombres coûtent une seconde passe
    renderer.setPixelRatio(1);
    scene.traverse(o=>{ if(o.isPoints) o.visible = true; });
  } else {
    renderer.shadowMap.enabled = false;
    renderer.setPixelRatio(0.75);            // on peint moins de pixels
    scene.traverse(o=>{ if(o.isPoints) o.visible = false; });   // ni poussière ni pollen
  }
  scene.traverse(o=>{ if(o.material) o.material.needsUpdate = true; });
  dire('Qualité : ' + CRANS[cranQualite], 2);
}

/* ═══════════════ 9 quinquies. LE RADAR (façon Metal Gear) ═══════════════
   Une carte vue de dessus, en haut à gauche : les murs, le joueur et son cône
   de regard, les ennemis en rouge, la clé en or, l'escalier en vert. */
const radarCv = document.getElementById('radar');
const radarCtx = radarCv.getContext('2d');
let radarT = 0;

function dessinerRadar(){
  const S = radarCv.width, cw = S / W, ch = S / H;
  const g = radarCtx;
  g.clearRect(0, 0, S, S);

  if(estDehors()){
    // dehors : fond herbe, les maisons en sombre, l'escalier en vert
    g.fillStyle = 'rgba(40,80,40,.5)'; g.fillRect(0,0,S,S);
  }
  // les cases
  for(let y=0;y<H;y++) for(let x=0;x<W;x++){
    const c = grid[y][x];
    if(c === WALL){ g.fillStyle = estDehors() ? 'rgba(60,50,40,.85)' : 'rgba(70,90,120,.85)'; g.fillRect(x*cw, y*ch, cw+.5, ch+.5); }
    else if(c === DOOR){ g.fillStyle = '#49d18a'; g.fillRect(x*cw, y*ch, cw, ch); }
  }
  // l'escalier / la porte (repère vert clignotant)
  if(doorPos){
    g.fillStyle = (Math.sin(radarT*4)>0) ? '#6effb0' : '#2a9d6a';
    g.fillRect(doorPos.x*cw-1, doorPos.y*ch-1, cw+2, ch+2);
  }
  // la clé (or), si pas encore prise
  if(keyPos && !joueur.cle){
    g.fillStyle = '#e8b661';
    g.beginPath(); g.arc(keyPos.x*cw+cw/2, keyPos.y*ch+ch/2, 2.6, 0, 7); g.fill();
  }
  // les ennemis (rouge), les vivants seulement
  g.fillStyle = '#ff4a3a';
  for(const e of (ennemis||[])){
    if(e.vie<=0) continue;
    g.beginPath(); g.arc(e.x*cw, e.y*ch, 2, 0, 7); g.fill();
  }
  if(boss && boss.mort<=0){
    g.fillStyle = boss.enrage ? '#ff2a1a' : '#ff7a3a';
    g.beginPath(); g.arc((boss.x/T)*cw, (boss.z/T)*ch, 3.6, 0, 7); g.fill();
  }
  // le joueur : un cône de regard + un point bleu
  const px = (joueur.x/T)*cw, py = (joueur.z/T)*ch;
  const a = joueur.lacet;                       // lacet=0 → vers -z (haut du radar)
  g.fillStyle = 'rgba(90,168,255,.28)';
  g.beginPath(); g.moveTo(px, py);
  g.arc(px, py, 22, -a - Math.PI/2 - 0.5, -a - Math.PI/2 + 0.5);
  g.closePath(); g.fill();
  g.fillStyle = '#8fd0ff';
  g.beginPath(); g.arc(px, py, 3, 0, 7); g.fill();
  g.strokeStyle = '#cfe6ff'; g.lineWidth = 1;
  g.beginPath(); g.arc(px, py, 3, 0, 7); g.stroke();
}

/* ═══════════════ 10. LA BOUCLE ═══════════════ */
const horloge = new THREE.Clock();
const pos = new THREE.Vector3();
let img=0, tFps=performance.now();
const elPerf = document.getElementById('perf');

function poserGuerrier(){
  const g = MODELES.guerrier; if(!g) return;
  const r = rooms[Math.min(2, rooms.length-1)] || rooms[0];
  const gx = cX(r)*T + T/2, gz = cY(r)*T + T/2;
  g.scale.setScalar(1);
  const bb = new THREE.Box3().setFromObject(g);
  const h = bb.getSize(new THREE.Vector3()).y || 1;
  g.scale.setScalar(1.78 / h);
  g.position.set(gx, 0, gz);
  g.traverse(o=>{ if(o.isMesh){ o.castShadow = true; o.frustumCulled = false;
    if(o.material && o.material.emissive){ o.material = o.material.clone(); o.material.emissive.setHex(0x400a0a); } }});
  monde.add(g);
  const mix = new THREE.AnimationMixer(g);
  const act = {};
  const EX = { Idle_Loop:'idle', Walk_Loop:'walk', Sword_Attack:'attaque', Hit_Chest:'hit', Hit_Head:'hit', Death01:'mort' };
  for(const c of (g.userData.anims||[])){ const k = EX[c.name]; if(k && !act[k]) act[k] = mix.clipAction(c); }
  guerrier = {
    obj:g, mix, act, cour:null, vie:8, vieMax:8, x:gx, z:gz, etat:'dort', cd:0, mortT:0,
    jouer(n){ const a = this.act[n] || this.act.idle; if(!a) return;
      if(a === this.cour && n!=='attaque' && n!=='hit') return;
      if(n==='attaque'||n==='hit'||n==='mort'){ a.reset().setLoop(THREE.LoopOnce,1); a.clampWhenFinished = true; }
      else a.setLoop(THREE.LoopRepeat, Infinity);
      if(this.cour && this.cour!==a) this.cour.fadeOut(0.12);
      a.reset().fadeIn(0.1).play(); this.cour = a; }
  };
  guerrier.jouer('idle');
  dire('Un guerrier t\'attend plus loin. Approche et appuie sur G pour le défier.', 5);
}
function majGuerrier(dt){
  const G = guerrier; if(!G) return;
  G.mix.update(dt);
  if(G.vie <= 0){ if(G.mortT>0){ G.mortT -= dt; if(G.mortT<=0){ monde.remove(G.obj); guerrier = null; } } return; }
  const dx = joueur.x - G.x, dz = joueur.z - G.z, d = Math.hypot(dx, dz) || 1;
  G.obj.rotation.y = Math.atan2(dx, dz) + Math.PI;      // il regarde le joueur
  if(G.etat === 'dort'){ G.jouer('idle'); return; }
  G.cd -= dt;
  if(d > 2.2){ const v = 2.4*dt; G.x += dx/d*v; G.z += dz/d*v; G.obj.position.set(G.x, 0, G.z); G.jouer('walk'); }
  else { G.jouer('attaque');
    if(G.cd <= 0){ G.cd = 1.5; if(d < 2.7) blesser(G.x - joueur.x, G.z - joueur.z); } }
}
let autoFps = { acc:0, n:0 };
function boucle(){
  const dt = Math.min(0.05, horloge.getDelta());
  const t  = horloge.elapsedTime;

  // AUTO-QUALITÉ : si ça rame sur une machine faible, on descend un cran tout seul
  autoFps.acc += dt; autoFps.n++;
  if(autoFps.acc >= 1.6){
    const fps = autoFps.n / autoFps.acc;
    if(fps < 28 && etat === 'jeu' && typeof cranQualite !== 'undefined' && cranQualite < 2){
      baisserQualite(); dire('Ça rame : qualité réduite pour rester fluide.', 2.4);
    }
    autoFps.acc = 0; autoFps.n = 0;
  }

  if(etat==='jeu'){
    /* -- marche -- */
    const pad = lireManette(dt);
    let av = (touches.KeyW||touches.KeyZ ?1:0) - (touches.KeyS ?1:0);
    let la = (touches.KeyD ?1:0) - (touches.KeyA||touches.KeyQ ?1:0);
    if(pad && (pad.ax || pad.ay)){ av = -pad.ay; la = pad.ax; }
    const court = touches.ShiftLeft||touches.ShiftRight || (pad && pad.court);
    joueur.dashCd = Math.max(0, joueur.dashCd - dt);
    // flèches gauche/droite : tourner sans souris (utile si le pointeur n'est pas capturé)
    // tourner au clavier : flèches gauche/droite, ou J et L
    if(touches.ArrowLeft  || touches.KeyJ) joueur.lacet += dt*2.0;
    if(touches.ArrowRight || touches.KeyL) joueur.lacet -= dt*2.0;
    if(touches.ArrowUp)   joueur.tangage = Math.min( 1.35, joueur.tangage + dt*1.4);
    if(touches.ArrowDown) joueur.tangage = Math.max(-1.35, joueur.tangage - dt*1.4);
    const v = (court?8.0:4.6) * dt;   // base = ancienne course ; Shift = fonce (Naruto)
    if(av||la){
      const n = Math.hypot(av,la);
      const sx = (-Math.sin(joueur.lacet)*av + Math.cos(joueur.lacet)*la)/n*v;
      const sz = (-Math.cos(joueur.lacet)*av - Math.sin(joueur.lacet)*la)/n*v;
      joueur.dx = sx/v; joueur.dz = sz/v;          // on retient la direction pour foncer
      const p = glisser(joueur.x, joueur.z, sx, sz);
      joueur.x = p.x; joueur.z = p.z;
      joueur.pas += dt*(court?13:8.5);
      const pasAv = Math.floor(joueur.pas/Math.PI);
      if(pasAv !== joueur.pasPrec && joueur.saut<=0){ joueur.pasPrec = pasAv; window.Sons?.pas(); }
      joueur.souffle += dt*(court?1.4:0.5);
    } else {
      joueur.souffle = Math.max(0, joueur.souffle - dt*0.7);
    }

    /* -- foncer -- */
    if(joueur.dash > 0){
      joueur.dash -= dt;
      const vd = 17 * dt;
      const p = glisser(joueur.x, joueur.z, joueur.dx*vd, joueur.dz*vd);
      joueur.x = p.x; joueur.z = p.z;
      joueur.inv = Math.max(joueur.inv, 0.12);     // on passe à travers les coups
    }

    /* -- l'enchaînement retombe si on n'enchaîne pas -- */
    if(joueur.comboT > 0){
      joueur.comboT -= dt;
      if(joueur.comboT <= 0){ joueur.combo = 0; elCombo.classList.remove('on'); }
    }

    /* -- le saut : gravité, retombée, pas de double saut -- */
    if(joueur.vy !== 0 || joueur.saut > 0){
      joueur.saut += joueur.vy * dt;
      joueur.vy   -= 15 * dt;                         // gravité
      if(joueur.saut <= 0){ joueur.saut = 0; joueur.vy = 0; }  // au sol
    }

    /* -- la tête bouge : ballant, roulis, souffle -- */
    const ballant = Math.sin(joueur.pas)*0.045 * (av||la?1:0);
    const lateral = Math.cos(joueur.pas*0.5)*0.03 * (av||la?1:0);
    joueur.roulis += ((la?-la*0.035:0) - joueur.roulis) * dt*6;
    joueur.secousse *= Math.pow(0.02, dt);

    tete.position.set(
      joueur.x + (Math.random()-.5)*joueur.secousse*0.5,
      1.62 + joueur.saut + ballant + Math.sin(t*1.3)*0.008 + (Math.random()-.5)*joueur.secousse*0.5,
      joueur.z + (Math.random()-.5)*joueur.secousse*0.5);

    /* -- la caméra recule quand on se regarde, et se rapproche si un mur gêne -- */
    let vise = (vue === 3) ? 3.8 : 0;
    if(vue === 3){
      for(let d = 0.6; d <= 3.8; d += 0.3){
        const cx = joueur.x + Math.sin(joueur.lacet)*d;
        const cz = joueur.z + Math.cos(joueur.lacet)*d;
        if(mur(cx, cz)){ vise = Math.max(0.9, d - 0.45); break; }
      }
    }
    reculCam += (vise - reculCam) * Math.min(1, dt*7);
    const pres = Math.min(1, reculCam);
    camera.position.set(0.5*pres, 0.30*pres, reculCam);
    camera.rotation.x = -0.15*pres;        // légère plongée, sinon on lui coupe les pieds
    if(vue === 3){ tete.updateMatrixWorld(true);
      const _wp = new THREE.Vector3(); camera.getWorldPosition(_wp);
      if(_wp.y < 0.5) camera.position.y += (0.5 - _wp.y);   // reste au-dessus du sol
    }
    // en vue extérieure, la lampe sort du corps : sinon on s'éclaire de l'intérieur
    lampe.position.set(0, -0.15 + 0.4*pres, 0.25 - 1.7*pres);

    /* -- le corps : il suit, il marche, il respire -- */
    if(vue === 3){
      avatar.position.set(joueur.x, joueur.saut, joueur.z);
      avatar.rotation.y = joueur.lacet + Math.PI;   // il regarde vers l'avant
      let anim = 'idle';
      if(joueur.saut > 0.06)     anim = 'jump';
      else if(av || la)          anim = court ? 'sprint' : 'walk';
      // nouvelle frappe -> animation d'attaque (si le modèle en a une)
      if(joueur.atkCd > (joueur.atkPrev||0) + 0.001) jouerAttaque();
      joueur.atkPrev = joueur.atkCd;
      if((joueur.animAtk||0) > 0) joueur.animAtk -= dt;   // l'attaque prime sur la marche
      else jouerAnim(anim);
      if(mixerPerso) mixerPerso.update(dt);

      // -- LA FRAPPE : un vrai geste de bras sur le squelette, APRÈS le mixer --
      avatar.rotation.x = 0;
      const em = avatar.userData.epeeMain;
      if(!actionsPerso.attaque && joueur.atkCd > 0){
        const dA = [0.40,0.30,0.44,0.62][joueur.combo] || 0.40;
        const kA = joueur.atkCd / dA;                    // 1 -> 0 sur le coup
        const elanCombat = Math.sin(kA*Math.PI);         // 0 -> 1 -> 0
        const sensA = joueur.combo === 1 ? -1 : 1;       // le 2e part en revers
        const bras = avatar.userData.brasD, avb = avatar.userData.avBrasD, buste = avatar.userData.buste;
        if(bras)  bras.quaternion.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1,0,0), -elanCombat*FRAPPE.bras*sensA));
        if(avb)   avb.quaternion.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1,0,0), -elanCombat*FRAPPE.avbras));
        if(buste) buste.quaternion.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,1,0),  elanCombat*FRAPPE.buste*sensA));
        const fx = -Math.sin(joueur.lacet), fz = -Math.cos(joueur.lacet);
        avatar.position.x += fx * elanCombat * FRAPPE.fente;
        avatar.position.z += fz * elanCombat * FRAPPE.fente;
        if(joueur.combo === 3) avatar.rotation.y += (1-kA) * Math.PI * 2;   // le tourbillon reste
        if(em && em.userData.base) em.rotation.z = em.userData.base.z + elanCombat * 1.2 * sensA;
      } else if(em && em.userData.base){
        em.rotation.z = em.userData.base.z;
      }

      // -- TRAÎNÉE DE LAME : un arc lumineux qui balaie (effet anime / Naruto) --
      if(!avatar.userData.trainee){
        const tm = new THREE.Mesh(
          new THREE.TorusGeometry(0.85, 0.05, 6, 20, Math.PI*1.25),
          new THREE.MeshBasicMaterial({ color:0xcfeeff, transparent:true, opacity:0, depthWrite:false, fog:false }));
        tm.rotation.x = Math.PI/2; tm.position.set(0.15, 1.05, 0.55); tm.renderOrder = 6;
        avatar.add(tm); avatar.userData.trainee = tm;
      }
      const tr = avatar.userData.trainee;
      if(joueur.atkCd > 0){
        const dA = [0.40,0.30,0.44,0.62][joueur.combo] || 0.40;
        const kA = joueur.atkCd / dA, el = Math.sin(kA*Math.PI);
        const sensA = joueur.combo === 1 ? -1 : 1;
        tr.visible = true;
        tr.material.opacity = 0.75 * el;
        tr.material.color.setHex(joueur.epee ? 0x8fd0ff : 0xcfeeff);
        tr.rotation.z = (0.6 - (1 - kA)) * Math.PI * 1.4 * sensA;   // il balaie de haut en bas
      } else {
        tr.material.opacity = 0;
      }
    }
    tete.rotation.set(0,0,0);
    tete.rotateY(joueur.lacet);
    tete.rotateX(joueur.tangage);
    tete.rotateZ(joueur.roulis + lateral*0.4);

    /* -- l'épée vit dans la main -- */
    {
      const marche = (av||la) ? 1 : 0;
      const bal = Math.sin(joueur.pas)*0.05*marche;
      const lat = Math.cos(joueur.pas*0.5)*0.035*marche;
      // le coup : un arc rapide de haut en bas, puis retour
      const duree = [0.40, 0.30, 0.44, 0.62][joueur.combo] || 0.40;
      const k = joueur.atkCd > 0 ? joueur.atkCd/duree : 0;
      const coup = Math.sin(k*Math.PI);
      const sens = joueur.combo === 1 ? -1 : 1;      // le deuxième part en revers
      const tour = joueur.combo === 3 ? (1-k)*Math.PI*2 : 0;   // le quatrième fait le tour
      arme.position.set(0.26 + lat*0.4 - coup*0.16,
                        -0.30 + bal + Math.sin(t*1.3)*0.006 - coup*0.04,
                        -0.62 - coup*0.12);
      arme.rotation.set(-0.22 + bal*1.4 - coup*1.35,
                        -0.52 + lat + coup*0.5*sens - tour,
                         0.30 + coup*0.85*sens);
      // la lame s'allume quand elle est enchantée
      const e = joueur.epee ? 1.35 : 0.35;
      arme.userData.lame.material.emissiveIntensity = e + coup*1.2;
      if(joueur.epee){
        arme.userData.lame.material.emissive.setHex(0x2f6fd8);
        arme.userData.gouttiere.material.color.setHex(0x9fd0ff);
      }
    }

    /* -- le soleil suit le joueur : l'ombre reste nette là où on regarde -- */
    if(estDehors()){
      jour.position.set(joueur.x + 17, 15, joueur.z + 11);
      jour.target.position.set(joueur.x, 0, joueur.z);
      jour.target.updateMatrixWorld();
    }

    /* -- la lampe respire -- */
    lampe.intensity = estDehors() ? 0
      : 40 + Math.sin(t*7.3)*2.4 + Math.sin(t*13.1)*1.4;
    if(joueur.inv>0){
      joueur.inv -= dt;
      lampe.color.setHex(Math.sin(t*30)>0 ? 0xff4433 : 0xbfd8ff);
    } else lampe.color.setHex(0xbfd8ff);
    joueur.atkCd = Math.max(0, joueur.atkCd - dt);

    /* -- les six lumières vont aux torches les plus proches -- */
    if(estDehors()) lumieres.forEach(l=>{ l.intensity = 0; });
    const proches = torches
      .map(tt=>({tt, d:(tt.wx-joueur.x)**2 + (tt.wz-joueur.z)**2}))
      .sort((a,b)=>a.d-b.d).slice(0, NB_LUM);
    lumieres.forEach((l,i)=>{
      if(i<proches.length){
        const tt = proches[i].tt;
        l.position.set(tt.wx, 2.2, tt.wz);
        // vacillement : deux sinus qui ne tombent jamais juste
          l.color.setHex(etageCourant().teinte);
        const f = Math.sin(t*11+tt.ph)*0.5 + Math.sin(t*6.3+tt.ph*2.1)*0.5;
        l.intensity = 58 + f*18;
      } else l.intensity = 0;
    });

    /* -- les flammes dansent -- */
    for(const f of flammes){
      if(f.fumee){
        // la fumée des cheminées : elle monte, s'étale, et repart en bas
        const m = ((t*0.42 + f.ph) % 5.2);
        f.sp.position.y = f.base + m*0.9;
        f.sp.position.x = f.x + Math.sin(t*0.5 + f.ph)*m*0.35;
        f.sp.scale.setScalar(0.7 + m*0.5);
        f.sp.material.opacity = Math.max(0, 0.34 - m*0.062);
        continue;
      }
      const s = 0.62 + Math.sin(t*12+f.ph)*0.09 + Math.sin(t*7.7+f.ph*3)*0.06;
      f.sp.scale.set(s*0.8, s*1.35, 1);
      f.sp.material.opacity = 0.8 + Math.sin(t*15+f.ph)*0.18;
    }

    /* -- braises -- */
    const pb = braises.geometry.attributes.position;
    braises.userData.forEach((b,i)=>{
      b.a += dt*b.v;
      if(b.a>3.0) b.a = 0;
      pb.setXYZ(i,
        b.x + b.ox + Math.sin(t*1.7+b.ph)*0.12*b.a,
        2.2 + b.a*0.75,
        b.z + b.oz + Math.cos(t*1.4+b.ph)*0.12*b.a);
    });
    pb.needsUpdate = true;
    braises.material.opacity = 0.85;

    /* -- poussière -- */
    const pp = poussiere.geometry.attributes.position;
    poussiere.userData.forEach((d,i)=>{
      d.y += d.v*dt;
      if(d.y > (estDehors() ? 6 : HT)) d.y = 0.05;
      pp.setXYZ(i, d.x + Math.sin(t*0.4+d.ph)*0.3, d.y, d.z + Math.cos(t*0.35+d.ph)*0.3);
    });
    pp.needsUpdate = true;

    /* -- la clé -- */
    if(!estDehors() && !joueur.cle && cleVerrouillee && meshCle.visible) meshCle.visible = false;
    if(!estDehors() && !joueur.cle && !cleVerrouillee){
      meshCle.rotation.y += dt*1.6;
      meshCle.position.y = 1.15 + Math.sin(t*1.9)*0.11;
      meshCle.children[4].scale.setScalar(1.8 + Math.sin(t*3.1)*0.25);
      if(Math.hypot(meshCle.position.x-joueur.x, meshCle.position.z-joueur.z) < 1.1){
        joueur.cle = true;
        meshCle.visible = false;
        elCle.classList.add('ok');
        dire('La clé est à toi. La porte t’attend.', 3.2);
        bip(660,0.09,'square',0.07); bip(880,0.14,'square',0.07,0.09);
      }
    }

    /* -- la porte -- */
    const u = porte.userData;
    const ouverte = joueur.cle;
    u.rideau.material.color.setHex(ouverte ? 0x49d18a : 0xc8392f);
    u.lum.color.setHex(ouverte ? 0x49d18a : 0xc8392f);
    u.rideau.material.opacity = 0.22 + Math.sin(t*2.4)*0.09;
    u.lum.intensity = 9 + Math.sin(t*2.4)*3.5;
  
    if(ouverte && Math.hypot(porte.position.x-joueur.x, porte.position.z-joueur.z) < 1.2) descendre();

    /* -- le gardien et ses ondes -- */
    majBoss(dt, t);
    majOndes(dt);
    majTranches(dt);

    /* -- le paysan : un adversaire, pas un obstacle -- */
    function majPaysan(e, dist){
      const o = e.obj.userData;
      const versToi = Math.atan2(joueur.x - e.x*T, joueur.z - e.y*T);
      e.obj.rotation.y = versToi;

      if(e.phase === 'garde'){
        // il attend, appuyé sur sa fourche. Rien ne bouge tant qu'on reste loin.
        o.outil.rotation.x = -0.35 + Math.sin(t*0.9 + e.ph)*0.03;
        o.lueur.intensity = 1.6;
        if(dist < 6.5){
          e.phase = 'approche'; e.tempo = 0;
          o.oeils.forEach(x=>x.material.color.setHex(0xff4a1a));
          bip(120, 0.3, 'sawtooth', 0.05);
        }
        return;
      }

      if(e.phase === 'approche'){
        o.lueur.intensity = 2.5 + Math.sin(t*5)*0.6;
        o.outil.rotation.x = -0.35;
        if(dist > 2.3){
          const vx = joueur.x - e.x*T, vz = joueur.z - e.y*T, n = Math.hypot(vx,vz)||1;
          const v = 1.5*dt;
          const nx = e.x*T + vx/n*v, nz = e.y*T + vz/n*v;
          if(!mur(nx, e.y*T)) e.x = nx/T;
          if(!mur(e.x*T, nz)) e.y = nz/T;
          e.obj.rotation.z = Math.sin(t*6 + e.ph)*0.08;
        } else {
          e.phase = 'arme'; e.tempo = 0.62;      // il lève la fourche : à toi de voir
          bip(330, 0.14, 'square', 0.06);
        }
        return;
      }

      if(e.phase === 'arme'){
        e.tempo -= dt;
        const k = 1 - e.tempo/0.62;
        o.outil.rotation.x = -0.35 - k*1.5;      // il l'arme au-dessus de l'épaule
        o.outil.position.y = 0.55 + k*0.35;
        o.lueur.intensity = 3 + k*9;             // et il s'allume : c'est le signal
        o.lueur.color.setHex(0xff3a10);
        if(e.tempo <= 0){ e.phase = 'frappe'; e.tempo = 0.16; }
        return;
      }

      if(e.phase === 'frappe'){
        e.tempo -= dt;
        const k = 1 - e.tempo/0.16;
        o.outil.rotation.x = -1.85 + k*2.4;      // la fourche s'abat
        o.outil.position.y = 0.9 - k*0.5;
        if(e.tempo <= 0){
          if(dist < 2.6) blesser(joueur.x - e.x*T, joueur.z - e.y*T);
          e.phase = 'repos'; e.tempo = 0.85;     // et là il est ouvert
          bip(90, 0.2, 'sawtooth', 0.08);
        }
        return;
      }

      if(e.phase === 'repos'){
        e.tempo -= dt;
        // la fourche traîne au sol, la lueur s'éteint : c'est ta fenêtre
        o.outil.rotation.x = 0.55;
        o.outil.position.y = 0.4;
        o.lueur.intensity = 1.2;
        o.lueur.color.setHex(0xff8a2a);
        e.obj.rotation.z = Math.sin(t*3)*0.05;
        if(e.tempo <= 0){ e.phase = 'approche'; }
        return;
      }
    }

    majGuerrier(dt);

    /* -- les habitants -- */
    for(const e of ennemis){
      if(e.vie<=0){
        if(e.mort>0){
          e.mort -= dt;
          const k = Math.max(0, e.mort/0.55);
          e.obj.scale.setScalar(k);
          e.obj.rotation.y += dt*9;
          if(e.mort<=0) e.obj.visible = false;
        }
        continue;
      }
      const dist = Math.hypot(joueur.x - e.x*T, joueur.z - e.y*T);
      if(e.type === 'paysan'){
        majPaysan(e, dist);
        e.obj.position.set(e.x*T, 0, e.y*T);
        continue;                                 // il a sa propre façon de se battre
      }
      e.cd -= dt;
      if(dist < 9 && e.cd<=0){
        // il avance vers toi, une case à la fois, sans traverser la pierre
        const vx = (joueur.x - e.x*T), vz = (joueur.z - e.y*T);
        const n  = Math.hypot(vx,vz)||1;
        const vitesses = { rat:1.9, slime:1.05, squelette:1.35, spectre:0.85 };
        const vit = (vitesses[e.type] ?? 1.2)*dt;
        const nx = e.x*T + vx/n*vit, nz = e.y*T + vz/n*vit;
        if(e.type==='spectre'){ e.x = nx/T; e.y = nz/T; }   // il passe à travers
        else {
          if(!mur(nx, e.y*T)) e.x = nx/T;
          if(!mur(e.x*T, nz)) e.y = nz/T;
        }
      }
      let yb;
      if(e.type==='slime')          yb = 0.42 + Math.abs(Math.sin(t*3.4+e.ph))*0.16;
      else if(e.type==='squelette') yb = Math.abs(Math.sin(t*6.5+e.ph))*0.07;
      else if(e.type==='spectre')   yb = 0.35 + Math.sin(t*1.6+e.ph)*0.22;
      else                          yb = 0.22 + Math.abs(Math.sin(t*11+e.ph))*0.05;
      e.obj.position.set(e.x*T, yb, e.y*T);
      e.obj.rotation.y = Math.atan2(joueur.x - e.x*T, joueur.z - e.y*T);
      if(e.type==='slime'){
        const s = 1 + Math.sin(t*3.4+e.ph)*0.14;
        e.obj.userData.corps.scale.set(1/Math.sqrt(s), s, 1/Math.sqrt(s));
      } else if(e.type==='squelette'){
        e.obj.rotation.z = Math.sin(t*6.5+e.ph)*0.09;     // il claque en marchant
      } else if(e.type==='spectre'){
        e.obj.userData.corps.material.opacity = 0.24 + Math.abs(Math.sin(t*0.9+e.ph))*0.22;
      }
      if(dist < 1.0 && joueur.inv <= 0){
        blesser(joueur.x - e.x*T, joueur.z - e.y*T);
        const n = dist || 1;                       // il rebondit et repart
        e.x -= (joueur.x - e.x*T)/n * 1.6 / T;
        e.y -= (joueur.z - e.y*T)/n * 1.6 / T;
        e.cd = 0.9;
      }
    }

    /* -- le radar, rafraîchi ~12 fois par seconde -- */
    radarT += dt;
    if(radarT % 1 < dt || true){ if((img & 3) === 0) dessinerRadar(); }

    /* -- message -- */
    if(msgT>0){ msgT -= dt; if(msgT<=0) elMsg.classList.remove('on'); }
    if(espritT>0 && !ecoute){ espritT -= dt; if(espritT<=0) elEsprit.classList.remove('on'); }

    /* -- les villageois : devant leur maison, un léger balancement + un coup d'oeil -- */
    for(const v of villageois){
      v.tempo -= dt;
      if(v.tempo <= 0){ v.glance = (Math.random()-0.5)*1.1; v.tempo = 3 + Math.random()*5; }   // il tourne la tête/hanches
      v.glanceCur += (v.glance - v.glanceCur) * Math.min(1, dt*2);
      v.obj.rotation.y = v.face + Math.sin(t*0.6 + v.ph)*0.10 + v.glanceCur;                    // balancement doux
      v.obj.position.set(v.x, Math.sin(t*1.4 + v.ph)*0.015, v.z);                               // respire
    }

    /* -- les écrans de l'isekai -- */
    if(annonceT>0){
      annonceT -= dt;
      const m = annonce.mesh;
      // elle glisse vers sa place, puis s'efface
      const cible = new THREE.Vector3();
      camera.getWorldPosition(cible);
      const q = new THREE.Quaternion(); camera.getWorldQuaternion(q);
      cible.addScaledVector(new THREE.Vector3(0,0,-1).applyQuaternion(q), 1.5)
           .addScaledVector(new THREE.Vector3(0,1,0).applyQuaternion(q), 0.80);
      m.position.lerp(cible, Math.min(1, dt*4));
      m.quaternion.slerp(q, Math.min(1, dt*4));
      m.material.opacity = Math.min(1, annonceT*1.6);
      if(annonceT<=0) m.visible = false;
    }
    if(statutOuvert){
      // la fenêtre reste où on l'a ouverte, mais se laisse rattraper si on marche
      const cible = new THREE.Vector3();
      camera.getWorldPosition(cible);
      const q = new THREE.Quaternion(); camera.getWorldQuaternion(q);
      cible.addScaledVector(new THREE.Vector3(0,0,-1).applyQuaternion(q), 0.95)
           .addScaledVector(new THREE.Vector3(0,1,0).applyQuaternion(q), -0.06);
      statut.mesh.position.lerp(cible, Math.min(1, dt*2.2));
      statut.mesh.quaternion.slerp(q, Math.min(1, dt*2.2));
    }

    /* -- les jumeaux te suivent -- */
    for(const j of jumeaux){
      const cx = joueur.x + j.dx, cz = joueur.z + j.dz;
      j.obj.position.x += (cx - j.obj.position.x) * Math.min(1, dt*3.2);
      j.obj.position.z += (cz - j.obj.position.z) * Math.min(1, dt*3.2);
      j.obj.rotation.y = joueur.lacet;
    }

    /* -- les objets flottent, et se ramassent en marchant dessus -- */
    for(let i=objets.length-1;i>=0;i--){
      const o = objets[i];
      o.obj.rotation.y += dt*1.7;
      o.obj.position.y = 0.75 + Math.sin(t*2.2 + o.ph)*0.09;
      if(Math.hypot(o.obj.position.x-joueur.x, o.obj.position.z-joueur.z) < 0.95){
        if(o.type === 'fiole'){
          if(joueur.vie < joueur.vieMax){ joueur.vie++; dessinerCoeurs(); dire('Une fiole. Un cœur repris.', 2); }
          else { dire('Une fiole, mais tes cœurs sont pleins.', 2); }
        } else {
          eclats++; sauvegarderPartie(); dire('Un éclat. ' + eclats + ' en tout.', 2);
        }
        bip(880, 0.08, 'sine', 0.06); bip(1320, 0.11, 'sine', 0.05, 0.07); window.Sons?.ramasse();
        monde.remove(o.obj); objets.splice(i,1);
      }
    }

    /* -- le décor cassé s'affaisse -- */
    for(let i=decors.length-1;i>=0;i--){
      const d = decors[i];
      if(d.casse <= 0) continue;
      d.casse -= dt;
      const k = Math.max(0, d.casse/0.45);
      d.obj.scale.set(1 + (1-k)*0.6, k, 1 + (1-k)*0.6);
      d.obj.rotation.y += dt*5;
      if(d.casse <= 0){ monde.remove(d.obj); decors.splice(i,1); }
    }

    /* -- l'épreuve du jumeau : le tenir huit secondes -- */
    if(jumeauxDepuis >= 0){
      if(!jumeaux.length) jumeauxDepuis = -1;      // il l'a perdu : l'épreuve échoue
      else {
        jumeauxDepuis += dt;
        if(jumeauxDepuis >= 8){ debloquer('DUPLICATION'); jumeauxDepuis = -1; }
      }
    }

    /* -- les pièges jaillissent, puis empalent ce qui passe -- */
    for(const p of pieges){
      if(p.sortie < 1){ p.sortie = Math.min(1, p.sortie + dt*3.5); p.obj.scale.y = 0.05 + p.sortie*0.95; }
      for(const e of ennemis){
        if(e.vie<=0) continue;
        if(Math.hypot(e.x*T - p.obj.position.x, e.y*T - p.obj.position.z) < 0.8){
          e.vie = 0; e.mort = 0.55; bip(140,0.2,'sawtooth',0.06);
          debloquer('PIÈGE');       // l'épreuve : le piège a servi
        }
      }
    }

    /* -- le coffre s'ouvre quand tu le touches -- */
    if(coffre && !coffre.ouvert &&
       Math.hypot(coffre.obj.position.x - joueur.x, coffre.obj.position.z - joueur.z) < 1.1){
      coffre.ouvert = true;
      coffre.couvercle.rotation.x = -1.15;
      coffre.couvercle.position.set(0, 0.62, -0.24);
      if(!joueur.epee){ joueur.epee = true; esprit("Une épée dormait dans le coffre. Elle est à toi."); }
      else if(joueur.vie < joueur.vieMax){ joueur.vie++; dessinerCoeurs(); esprit("Le coffre rendait un cœur."); }
      else esprit("Le coffre était vide. Le donjon a de l'humour.");
      bip(660,0.09,'square',0.07); bip(880,0.14,'square',0.07,0.09);
    }
  }

  renderer.render(scene, camera);

  img++;
  const maintenant = performance.now();
  if(maintenant - tFps > 1000){
    const r = renderer.info.render;
    elPerf.textContent = Math.round(img*1000/(maintenant-tFps)) + ' i/s · '
                       + r.calls + ' appels · ' + (r.triangles/1000).toFixed(0) + 'k tri';
    img = 0; tFps = maintenant;
  }
}

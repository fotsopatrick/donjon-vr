/* ---- le passage en VR : prêt le jour où un casque ouvre cette page ---- */
if(navigator.xr){
  navigator.xr.isSessionSupported('immersive-vr').then(ok=>{
    if(!ok) return;
    const b = document.createElement('button');
    b.className = 'bouton'; b.textContent = 'Entrer en VR';
    b.style.cssText = 'position:fixed;right:22px;top:22px;z-index:25;padding:12px 26px;font-size:13px';
    b.onclick = async ()=>{
      const s = await navigator.xr.requestSession('immersive-vr', { optionalFeatures:['local-floor'] });
      renderer.xr.setReferenceSpaceType('local-floor');
      await renderer.xr.setSession(s);
      b.style.display = 'none';
      s.addEventListener('end', ()=>{ b.style.display = ''; });

}

/* une onde qui court au sol : elle te touche quand son bord te dépasse */
function lancerOnde(x, z){
  const m = new THREE.Mesh(
    new THREE.RingGeometry(0.4, 0.75, 40),
    new THREE.MeshBasicMaterial({ color:0x8fdcff, transparent:true, opacity:0.85,
      blending:THREE.AdditiveBlending, depthWrite:false, side:THREE.DoubleSide }));

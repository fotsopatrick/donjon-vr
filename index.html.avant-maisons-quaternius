/* Deux façons de regarder, pour que ça marche partout :
   1. pointeur capturé — la souris tourne la tête librement (le confort normal) ;
   2. sinon, on maintient le bouton et on tire, comme sur une carte.
   Le second sert de secours quand Chrome refuse la capture. */
let tire = false, dernierX = 0, dernierY = 0;

function tourner(dx, dy){
  joueur.lacet   -= dx * 0.0022;
  joueur.tangage -= dy * 0.0022;
  joueur.tangage = Math.max(-1.35, Math.min(1.35, joueur.tangage));
}

document.addEventListener('mousemove', e=>{
  if(verrou){ tourner(e.movementX, e.movementY); return; }
  if(tire){
    tourner(e.clientX - dernierX, e.clientY - dernierY);
    dernierX = e.clientX; dernierY = e.clientY;
  }
});
renderer.domElement.addEventListener('mousedown', e=>{
  if(verrou) return;
  tire = true; dernierX = e.clientX; dernierY = e.clientY;
  renderer.domElement.style.cursor = 'grabbing';
});
addEventListener('mouseup', ()=>{
  tire = false;
  renderer.domElement.style.cursor = '';
});

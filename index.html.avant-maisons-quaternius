    const feu = new THREE.PointLight(teinte, 6, 8, 2); feu.position.set(0,1.35,0); g.add(feu);
    const halo = new THREE.Mesh(new THREE.SphereGeometry(0.17,10,9),
      new THREE.MeshBasicMaterial({color:teinte})); halo.position.set(0,1.1,0); g.add(halo);
    const ban = new THREE.Mesh(new THREE.PlaneGeometry(0.95,1.7),
      new THREE.MeshStandardMaterial({color:teinte, roughness:0.85, side:THREE.DoubleSide,
        emissive:teinte, emissiveIntensity:0.18}));
    ban.position.set(0,1.7,-1.25); g.add(ban);
  }

  // fusion par matière : ~3 dessins/salle au lieu de quinze
  fondre(g);
  g.position.set(wx, 0, wz);
  styliser(g, 0.02);
  monde.add(g);
  poserPropsSalle(r, wx, wz);   // vrais props texturés par-dessus
}
function batir(){
  hemi.color.setHex(0x6a5a44); hemi.groundColor.setHex(0x201a12); hemi.intensity = 0.95;   // donjon : bien éclairé (torche)
  // on vide l'étage précédent
  while(monde.children.length){
    const o = monde.children.pop();
    o.traverse?.(n=>{ n.geometry?.dispose?.(); });
    monde.remove(o);
  }
  flammes=[]; meshEnnemis=[]; coffre=null; pieges=[]; jumeaux=[];
  decors=[]; objets=[];
  if(boss){ scene.remove(boss.jauge.mesh); boss = null; }
  ondes = []; tranches = []; projectiles = [];
  murIM=null;

  construireMurs();

  /* --- sol et plafond --- */
  const solT = texSol.clone(); solT.needsUpdate=true; solT.repeat.set(W, H);
  const sol = new THREE.Mesh(
    new THREE.PlaneGeometry(W*T, H*T),
    new THREE.MeshStandardMaterial({ map:solT, bumpMap:texRelief, bumpScale:0.18, roughness:0.62, color:0x7d8798 }));
  sol.rotation.x = -Math.PI/2;
  sol.position.set(W*T/2, 0, H*T/2);
  sol.receiveShadow = true;
  monde.add(sol);

  const plaT = texMur.clone(); plaT.needsUpdate=true; plaT.repeat.set(W*0.6, H*0.6);
  const plafond = new THREE.Mesh(
    new THREE.PlaneGeometry(W*T, H*T),
    new THREE.MeshStandardMaterial({ map:plaT, roughness:1, color:0x3a4356 }));
  plafond.rotation.x = Math.PI/2;
  plafond.position.set(W*T/2, HT, H*T/2);
  monde.add(plafond);

  /* --- les torches : un fer, une flamme, une lueur sur le mur --- */
  const geoFer = new THREE.CylinderGeometry(0.035, 0.055, 0.5, 6);
  const matFer = new THREE.MeshStandardMaterial({ color:0x1b1713, roughness:0.85, metalness:0.6 });
  for(const t of torches){
    const wx = t.x*T+T/2, wz = t.y*T+T/2;
    const px = wx + t.dx*(T/2+0.06), pz = wz + t.dy*(T/2+0.06);
    const fer = new THREE.Mesh(geoFer, matFer);
    fer.position.set(px, 1.95, pz);
    fer.rotation.set(t.dy*0.42, 0, -t.dx*0.42);
    monde.add(fer);

    const fl = new THREE.Sprite(new THREE.SpriteMaterial({
      map:texFlamme, color:etageCourant().teinte, blending:THREE.AdditiveBlending,
      depthWrite:false, transparent:true, opacity:0.95 }));
    fl.position.set(px, 2.22, pz);
    fl.scale.set(0.75, 1.0, 1);
    monde.add(fl);
    flammes.push({ sp:fl, ph:t.ph, x:px, z:pz });
    t.wx=px; t.wz=pz;

    // un éclat de cristal planté dans la pierre, sous la flamme
    const cristal = new THREE.Mesh(
      new THREE.OctahedronGeometry(0.19, 0),
      new THREE.MeshStandardMaterial({ color:etageCourant().teinte, emissive:etageCourant().teinte,
        emissiveIntensity:0.75, transparent:true, opacity:0.92,
        roughness:0.06, metalness:0.1 }));
    cristal.position.set(px - t.dx*0.1, 1.5, pz - t.dy*0.1);
    cristal.rotation.set(0.5, Math.random()*3, 0.4);
    cristal.scale.set(1, 1.9, 1);
    monde.add(cristal);
  }

  /* --- les runes au sol, sous les feux --- */
  {
    const runeGeo = new THREE.RingGeometry(0.55, 0.95, 24, 1);
    const runeMat = new THREE.MeshBasicMaterial({ color:etageCourant().teinte, transparent:true,
      opacity:0.30, blending:THREE.AdditiveBlending, depthWrite:false, side:THREE.DoubleSide });
    for(const t of torches){
      const r = new THREE.Mesh(runeGeo, runeMat);
      r.rotation.x = -Math.PI/2;
      r.position.set(t.wx - t.dx*0.9, 0.03, t.wz - t.dy*0.9);
      monde.add(r);
    }
  }

  /* --- braises qui montent des torches --- */
  const NB_BR = Math.min(260, torches.length*22);
  const posBr = new Float32Array(NB_BR*3);
  const brData = [];
  for(let i=0;i<NB_BR;i++){
    const t = torches[i % Math.max(1,torches.length)] || {wx:0,wz:0};
    brData.push({ x:t.wx||0, z:t.wz||0, v:0.35+Math.random()*0.7, a:Math.random()*3.2,
                  ph:Math.random()*6, ox:(Math.random()-.5)*0.2, oz:(Math.random()-.5)*0.2 });
  }
  braises = new THREE.Points(
    new THREE.BufferGeometry().setAttribute('position', new THREE.BufferAttribute(posBr,3)),
    new THREE.PointsMaterial({ map:texHalo, color:0x8fd4ff, size:0.075, sizeAttenuation:true,
      blending:THREE.AdditiveBlending, transparent:true, depthWrite:false, opacity:0.85 }));
  braises.userData = brData;
  monde.add(braises);

  /* --- poussière en suspension, elle attrape la lampe --- */
  const NB_PO = 420, posPo = new Float32Array(NB_PO*3), poData=[];
  for(let i=0;i<NB_PO;i++){
    poData.push({ x:Math.random()*W*T, y:Math.random()*HT, z:Math.random()*H*T,
                  v:0.02+Math.random()*0.05, ph:Math.random()*6 });
  }
  poussiere = new THREE.Points(
    new THREE.BufferGeometry().setAttribute('position', new THREE.BufferAttribute(posPo,3)),
    new THREE.PointsMaterial({ map:texHalo, color:0xd9c9a4, size:0.028, sizeAttenuation:true,
      transparent:true, opacity:0.5, depthWrite:false }));
  poussiere.userData = poData;
  monde.add(poussiere);

  /* --- la clé : un anneau d'or qui tourne dans son halo --- */
  meshCle = new THREE.Group();
  const orMat = new THREE.MeshStandardMaterial({
    color:0xe8b661, emissive:0xffa73a, emissiveIntensity:0.85, roughness:0.28, metalness:0.95 });
  const anneau = new THREE.Mesh(new THREE.TorusGeometry(0.17, 0.045, 8, 20), orMat);
  const tige   = new THREE.Mesh(new THREE.BoxGeometry(0.055, 0.42, 0.055), orMat);
  tige.position.y = -0.3;
  const dent1  = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.055, 0.055), orMat);
  dent1.position.set(0.08, -0.42, 0);
  const dent2  = dent1.clone(); dent2.position.set(0.08, -0.29, 0);
  meshCle.add(anneau, tige, dent1, dent2);
  const halo = new THREE.Sprite(new THREE.SpriteMaterial({
    map:texHalo, color:0xffbe55, blending:THREE.AdditiveBlending,
    depthWrite:false, transparent:true, opacity:0.4 }));
  halo.scale.set(1.9,1.9,1);
  meshCle.add(halo);
  meshCle.position.set(keyPos.x*T+T/2, 1.15, keyPos.y*T+T/2);
  const lumCle = new THREE.PointLight(0xffb84d, 14, 9, 1.8);
  meshCle.add(lumCle);
  monde.add(meshCle);

  /* --- la porte : une arche et un rideau de lumière --- */
  porte = new THREE.Group();
  // un vrai escalier qui s'enfonce dans la pierre
  const marbre = new THREE.MeshStandardMaterial({ color:0x6e7688, roughness:0.6, metalness:0.1 });
  const NB_M = 7;
  for(let i=0;i<NB_M;i++){
    const m = new THREE.Mesh(new THREE.BoxGeometry(T*0.82, 0.16, T/NB_M), marbre);
    m.position.set(0, -0.08 - i*0.19, -T*0.4 + i*(T*0.9/NB_M));
    porte.add(m);
  }
  // les deux joues de l'escalier, pour qu'il ne flotte pas
  for(const c of [-1, 1]){
    const joue = new THREE.Mesh(new THREE.BoxGeometry(0.12, 1.5, T*0.95), marbre);
    joue.position.set(c*T*0.45, -0.75, -T*0.02);
    porte.add(joue);
  }
  // la lueur du fond : c'est elle qui appelle
  const rideau = new THREE.Mesh(
    new THREE.PlaneGeometry(T*0.8, 1.5),
    new THREE.MeshBasicMaterial({ color:0xc8392f, transparent:true, opacity:0.32,
      blending:THREE.AdditiveBlending, depthWrite:false, side:THREE.DoubleSide }));
  rideau.rotation.x = -Math.PI/2;
  rideau.position.set(0, -1.35, T*0.35);
  const cadre = new THREE.Mesh(
    new THREE.TorusGeometry(T*0.5, 0.09, 6, 18, Math.PI),
    new THREE.MeshStandardMaterial({ color:0x2a2118, roughness:0.7, metalness:0.5 }));
  cadre.position.y = HT*0.55;
  porte.add(rideau, cadre);
  porte.position.set(doorPos.x*T+T/2, 0, doorPos.y*T+T/2);
  const lumPorte = new THREE.PointLight(0xc8392f, 10, 10, 1.8);
  lumPorte.position.y = -0.9;
  porte.add(lumPorte);
  porte.userData = { rideau, cadre, lum:lumPorte };
  monde.add(porte);

  /* --- ce qui traîne : contre les murs pour le décor, au large pour les objets --- */
  for(let y=1;y<H-1;y++) for(let x=1;x<W-1;x++){
    if(grid[y][x] !== FLOOR) continue;
    if(keyPos && x===keyPos.x && y===keyPos.y) continue;
    if(doorPos && x===doorPos.x && y===doorPos.y) continue;
    // contre un mur ? alors du décor. Au milieu ? alors parfois un objet.
    const colle = [[1,0],[-1,0],[0,1],[0,-1]].some(([dx,dy])=>grid[y+dy][x+dx]===WALL);
    if(colle && Math.random() < 0.13) poserDecor(x, y);
    else if(!colle && Math.random() < 0.035)
      poserObjet(Math.random() < 0.55 ? 'fiole' : 'eclat', x*T+T/2, y*T+T/2);
  }

  /* --- chaque salle prend son thème (piliers, crypte, garde, réserve, trésor, sanctuaire) --- */
  for(const r of rooms) meublerSalle(r);

  /* --- le gardien du palier --- */
  guerrier = null;
  if(bossSalle) creerBoss(bossSalle.x, bossSalle.y);
  if(niveau === 1) poserGuerrier();

  /* --- tout le décor passe au trait --- */
  styliser(monde, 0.02);

  /* --- les habitants --- */
  for(const e of ennemis){
    let g;

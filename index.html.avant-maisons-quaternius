/* ═══════════════ 9 bis. L'ESPRIT DU DONJON ═══════════════
   Porté du jeu 2D : mêmes phrases reconnues, mêmes effets, mêmes réponses.
   Nouveau : il entend la voix, et il répond à voix haute.               */

const elEsprit  = document.getElementById('esprit');
const elEntendu = document.getElementById('entendu');
const elRepond  = document.getElementById('repond');
